<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BgIptvPlayer.Native"
        x:Class="BgIptvPlayer.Native.MainWindow" Title="BG IPTV Player" Icon="avares://BG-IPTV-Player/Assets/app-icon.png"
        Width="1500" Height="900" MinWidth="1120" MinHeight="700" Background="#0F1114" Foreground="#F2F4F7"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter" KeyDown="Window_KeyDown" PointerMoved="Window_PointerMoved">
  <Window.Resources>
    <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
    <SolidColorBrush x:Key="SliderTrackFill" Color="#525B69"/>
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#59636F"/>
    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#59636F"/>
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#F2622E"/>
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FF8A5C"/>
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FF8A5C"/>
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFFFFF"/>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button"><Setter Property="Background" Value="#1C2026"/><Setter Property="Foreground" Value="#F2F4F7"/><Setter Property="BorderBrush" Value="#262B33"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="16,11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/></Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="#242931"/><Setter Property="BorderBrush" Value="#343B45"/></Style>
    <Style Selector="Button.navIcon"><Setter Property="Width" Value="50"/><Setter Property="Height" Value="50"/><Setter Property="CornerRadius" Value="25"/><Setter Property="Padding" Value="14"/><Setter Property="Background" Value="#1C2026"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.navIcon:pointerover"><Setter Property="Background" Value="#242931"/></Style>
    <Style Selector="Button.navIcon.active"><Setter Property="Background" Value="#2D333C"/><Setter Property="BorderBrush" Value="#F2622E"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.sectionButton"><Setter Property="Height" Value="46"/><Setter Property="Width" Value="126"/><Setter Property="Padding" Value="15,0"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="CornerRadius" Value="23"/><Setter Property="Background" Value="#14171B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#232830"/><Setter Property="Foreground" Value="#A3ABB8"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.sectionButton:pointerover"><Setter Property="Background" Value="#242931"/><Setter Property="BorderBrush" Value="#343B45"/><Setter Property="Foreground" Value="#F2F4F7"/></Style>
    <Style Selector="Button.sectionButton.active"><Setter Property="Background" Value="#33F2622E"/><Setter Property="Foreground" Value="#FF8A5C"/><Setter Property="BorderBrush" Value="#F2622E"/></Style>
    <Style Selector="Button.playerAction"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.playerAction:pointerover"><Setter Property="Background" Value="#2D333C"/></Style>
    <Style Selector="Button.playerAction.primary"><Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/><Setter Property="CornerRadius" Value="24"/><Setter Property="Background" Value="#F2622E"/><Setter Property="BorderBrush" Value="#FF8A5C"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.playerAction.primary:pointerover"><Setter Property="Background" Value="#F5764A"/></Style>
    <Style Selector="Button.backButton"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Background" Value="#242931"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.historyAction"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Background" Value="#242931"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.libCard"><Setter Property="MinHeight" Value="260"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="#1C2026"/><Setter Property="BorderBrush" Value="#262B33"/><Setter Property="BorderThickness" Value="1"/><Setter Property="ClipToBounds" Value="True"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/></Style>
    <Style Selector="Button.libCard:pointerover"><Setter Property="Background" Value="#242931"/><Setter Property="BorderBrush" Value="#343B45"/></Style>
    <Style Selector="Button.linkButton"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="#A3ABB8"/><Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.linkButton:pointerover"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#F2622E"/></Style>
    <Style Selector="TextBox"><Setter Property="Background" Value="#14171B"/><Setter Property="Foreground" Value="#F2F4F7"/><Setter Property="BorderBrush" Value="#262B33"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="15,11"/></Style>
    <Style Selector="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="CornerRadius" Value="0"/></Style>
    <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="#242931"/></Style>
    <Style Selector="ListBoxItem:selected /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="#242931"/></Style>
    <Style Selector="ListBoxItem:pointerover"><Setter Property="Background" Value="#191D22"/></Style>
    <Style Selector="Slider"><Setter Property="Foreground" Value="#F2622E"/></Style>
    <Style Selector="Slider.volume"><Setter Property="Width" Value="84"/><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="0"/><Setter Property="Margin" Value="4,-12,2,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style Selector="Slider.volume /template/ Thumb"><Setter Property="Width" Value="13"/><Setter Property="Height" Value="13"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Background" Value="#F2F4F7"/><Setter Property="BorderBrush" Value="#F2F4F7"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style Selector="Slider.volume /template/ RepeatButton"><Setter Property="MinHeight" Value="0"/></Style>
    <Style Selector="ProgressBar"><Setter Property="Foreground" Value="#F2622E"/><Setter Property="Background" Value="#2D333C"/><Setter Property="CornerRadius" Value="2"/></Style>
    <Style Selector="Button.settingsTab"><Setter Property="Height" Value="46"/><Setter Property="CornerRadius" Value="13"/><Setter Property="Padding" Value="13,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#A3ABB8"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="Button.settingsTab:pointerover"><Setter Property="Background" Value="#1C2026"/><Setter Property="Foreground" Value="#F2F4F7"/></Style>
    <Style Selector="Button.settingsTab.active"><Setter Property="Background" Value="#26F2622E"/><Setter Property="Foreground" Value="#FF8A5C"/></Style>
    <Style Selector="Button.optionCard"><Setter Property="Height" Value="74"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="16,0"/><Setter Property="Background" Value="#1C2026"/><Setter Property="BorderBrush" Value="#262B33"/><Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style Selector="Button.optionCard:pointerover"><Setter Property="Background" Value="#242931"/><Setter Property="BorderBrush" Value="#343B45"/></Style>
    <Style Selector="Button.optionCard.active"><Setter Property="Background" Value="#1FF2622E"/><Setter Property="BorderBrush" Value="#F2622E"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#171A1F"/><Setter Property="BorderBrush" Value="#262B33"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="22"/></Style>
    <Style Selector="TextBlock.cardTitle"><Setter Property="FontSize" Value="14.5"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.cardHint"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#A3ABB8"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="19"/></Style>
    <Style Selector="TextBlock.sectionTitle"><Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style Selector="TextBlock.eyebrow"><Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#6B7482"/></Style>
    <Style Selector="Border.channelCard"><Setter Property="Background" Value="#1C2026"/><Setter Property="BorderBrush" Value="#262B33"/></Style>
    <Style Selector="ListBox.cards ListBoxItem:pointerover"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="ListBox.cards ListBoxItem:selected"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="ListBox.cards ListBoxItem:selected /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="ListBox.cards ListBoxItem:pointerover Border.channelCard"><Setter Property="Background" Value="#242931"/><Setter Property="BorderBrush" Value="#343B45"/></Style>
    <Style Selector="ListBox.cards ListBoxItem:selected Border.channelCard"><Setter Property="Background" Value="#2D333C"/><Setter Property="BorderBrush" Value="#F2622E"/></Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#191D22"/></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#242931"/></Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#2D333C"/></Style>
    <Style Selector="ListBox.cards ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="ListBox.cards ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="ListBox.cards ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement"><Setter Property="Background" Value="#14171B"/><Setter Property="BorderBrush" Value="#262B33"/></Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="#14171B"/><Setter Property="BorderBrush" Value="#343B45"/></Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement"><Setter Property="Background" Value="#14171B"/><Setter Property="BorderBrush" Value="#F2622E"/></Style>
    <Style Selector="TextBox:focus-within /template/ Border#PART_BorderElement"><Setter Property="Background" Value="#14171B"/><Setter Property="BorderBrush" Value="#F2622E"/></Style>
    <Style Selector="TextBox.search /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style Selector="TextBox.search:focus-within /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style Selector="Button.homeAction"><Setter Property="Height" Value="78"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Background" Value="#171A1F"/><Setter Property="BorderBrush" Value="#262B33"/><Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style Selector="Button.homeAction:pointerover"><Setter Property="Background" Value="#242931"/><Setter Property="BorderBrush" Value="#F2622E"/></Style>
  </Window.Styles>

  <Grid x:Name="RootGrid" ColumnDefinitions="0,*">
    <Grid x:Name="HomePage" Grid.Column="1" Background="#0F1114" RowDefinitions="86,*,Auto" IsVisible="True">
      <Grid Margin="34,0" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="16" VerticalAlignment="Center"><Image Source="avares://BG-IPTV-Player/Assets/app-icon.png" Height="34" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="BG IPTV Player" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/><Border Grid.Column="2" Width="330" Height="42" CornerRadius="21" Background="#1C2026" BorderBrush="#262B33" BorderThickness="1" VerticalAlignment="Center"><Grid ColumnDefinitions="Auto,*"><Viewbox Width="17" Height="17" Margin="15,0,0,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M11,4 A7,7 0 1 0 11,18 A7,7 0 1 0 11,4 M16,16 L21,21" Stroke="#6B7482" StrokeThickness="1.9" StrokeLineCap="Round"/></Canvas></Viewbox><TextBox Grid.Column="1" x:Name="HomeSearchBox" Classes="search" Watermark="Tüm içerikte ara" KeyDown="HomeSearchBox_KeyDown" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="11,0" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,10,0"/></Grid></Border><StackPanel Grid.Column="4" VerticalAlignment="Center"><TextBlock x:Name="HomeTimeText" Text="00:00" FontSize="19" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock x:Name="HomeDateText" Text="" FontSize="11" Foreground="#A3ABB8" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel></Grid>
      <Grid Grid.Row="1" Margin="34,12,34,0" RowDefinitions="*,Auto" MaxHeight="660">
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="18">
          <Button Grid.Column="0" Classes="libCard" Click="HomeLive_Click"><Border CornerRadius="20" ClipToBounds="True"><Grid><Ellipse Width="260" Height="260" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,-110,0"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#1FF2622E" Offset="0"/><GradientStop Color="#00F2622E" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18"><Border Width="86" Height="86" CornerRadius="26" Background="#26F2622E" HorizontalAlignment="Center"><Viewbox Width="42" Height="42"><Canvas Width="24" Height="24"><Path Data="M4,6 L20,6 L20,18 L4,18 Z M8,22 L16,22 M12,18 L12,22 M8,2 L12,6 L16,2" Stroke="#F2622E" StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox></Border><StackPanel Spacing="7"><TextBlock Text="Canlı TV" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/><TextBlock x:Name="HomeLiveCount" Text="0 kanal" FontSize="12.5" Foreground="#A3ABB8" HorizontalAlignment="Center" TextAlignment="Center"/></StackPanel></StackPanel></Grid></Border></Button>
          <Button Grid.Column="1" Classes="libCard" Click="HomeMovie_Click"><Border CornerRadius="20" ClipToBounds="True"><Grid><Ellipse Width="260" Height="260" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,-110,0"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#1FF2622E" Offset="0"/><GradientStop Color="#00F2622E" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18"><Border Width="86" Height="86" CornerRadius="26" Background="#26F2622E" HorizontalAlignment="Center"><Viewbox Width="42" Height="42"><Canvas Width="24" Height="24"><Path Data="M3,8 L21,8 L21,20 L3,20 Z M3,8 L5,3 L21,3 L19,8 M8,3 L6,8 M14,3 L12,8" Stroke="#F2622E" StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox></Border><StackPanel Spacing="7"><TextBlock Text="Filmler" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/><TextBlock x:Name="HomeMovieCount" Text="0 film" FontSize="12.5" Foreground="#A3ABB8" HorizontalAlignment="Center" TextAlignment="Center"/></StackPanel></StackPanel></Grid></Border></Button>
          <Button Grid.Column="2" Classes="libCard" Click="HomeSeries_Click"><Border CornerRadius="20" ClipToBounds="True"><Grid><Ellipse Width="260" Height="260" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,-110,0"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#1FF2622E" Offset="0"/><GradientStop Color="#00F2622E" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18"><Border Width="86" Height="86" CornerRadius="26" Background="#26F2622E" HorizontalAlignment="Center"><Viewbox Width="42" Height="42"><Canvas Width="24" Height="24"><Path Data="M7,3 L21,3 L21,17 L7,17 Z M3,7 L3,21 L17,21" Stroke="#F2622E" StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox></Border><StackPanel Spacing="7"><TextBlock Text="Diziler" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/><TextBlock x:Name="HomeSeriesCount" Text="0 dizi" FontSize="12.5" Foreground="#A3ABB8" HorizontalAlignment="Center" TextAlignment="Center"/></StackPanel></StackPanel></Grid></Border></Button>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="18" Margin="0,18,0,0">
          <Button Grid.Column="0" Classes="homeAction" Click="RefreshPlaylist_Click"><StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M17.65,6.35 A8,8 0 1 0 19.73,14 H17.65 A6,6 0 1 1 16.23,8.17 L13,11.4 H21 V3.4 Z" Stroke="#FF8A5C" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox><TextBlock Text="Yenile" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button>
          <Button Grid.Column="1" Classes="homeAction" Click="ShowAboutFromHome_Click"><StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M12,10 L12,17 M12,7 L12.01,7" Stroke="#FF8A5C" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox><TextBlock Text="Hakkında" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button>
          <Button Grid.Column="2" Classes="homeAction" Click="ShowSettingsFromHome_Click"><StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M19.14,12.94 C19.18,12.63 19.2,12.32 19.2,12 C19.2,11.68 19.18,11.37 19.13,11.06 L21.23,9.42 L19.23,5.96 L16.76,6.96 C16.26,6.57 15.72,6.25 15.12,6.01 L14.74,3.38 H10.74 L10.36,6.01 C9.76,6.25 9.21,6.58 8.72,6.96 L6.25,5.96 L4.25,9.42 L6.35,11.06 C6.3,11.37 6.28,11.69 6.28,12 C6.28,12.32 6.3,12.63 6.35,12.94 L4.25,14.58 L6.25,18.04 L8.72,17.04 C9.21,17.43 9.76,17.75 10.36,17.99 L10.74,20.62 H14.74 L15.12,17.99 C15.72,17.75 16.27,17.42 16.76,17.04 L19.23,18.04 L21.23,14.58 Z M12.74,15.5 A3.5,3.5 0 1 1 12.74,8.5 A3.5,3.5 0 1 1 12.74,15.5" Stroke="#FF8A5C" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox><TextBlock Text="Ayarlar" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button>
        </Grid>
      </Grid>
      <Border Grid.Row="2" HorizontalAlignment="Left" Margin="34,26,34,28" CornerRadius="100" Background="#1C2026" BorderBrush="#262B33" BorderThickness="1" Padding="15,9"><StackPanel Orientation="Horizontal" Spacing="10"><Viewbox Width="15" Height="15" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M4,4 L11,4 L20,13 L13,20 L4,11 Z M7.6,7.6 L7.61,7.6" Stroke="#6B7482" StrokeThickness="1.7" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox><TextBlock x:Name="HomeVersionText" Text="BG IPTV Player" FontSize="11.5" Foreground="#A3ABB8" VerticalAlignment="Center"/></StackPanel></Border>
    </Grid>

    <Grid x:Name="Sidebar" Grid.Column="0" ColumnDefinitions="92,*" IsVisible="False">
      <Border Background="#14171B" BorderBrush="#262B33" BorderThickness="0,0,1,0"><Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" Margin="0,18">
        <Image Source="avares://BG-IPTV-Player/Assets/app-icon.png" Height="36" HorizontalAlignment="Center"/>
        <Button Grid.Row="1" Classes="navIcon" Click="BackHome_Click" Margin="0,24,0,12" HorizontalAlignment="Center" ToolTip.Tip="Ana ekran"><Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Data="M15.4,4 L7.4,12 L15.4,20 L17.5,17.9 L11.6,12 L17.5,6.1 Z" Fill="#F2F4F7"/></Canvas></Viewbox></Button>
        <Button Grid.Row="2" Classes="navIcon active" Click="LiveSection_Click" Margin="0,6" HorizontalAlignment="Center" ToolTip.Tip="Canlı TV"><Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Data="M4,5 H20 A2,2 0 0 1 22,7 V17 A2,2 0 0 1 20,19 H4 A2,2 0 0 1 2,17 V7 A2,2 0 0 1 4,5 M8,1 L12,5 L16,1 L17.5,2.5 L15,5 H9 L6.5,2.5 Z M9,9 V15 L15,12 Z" Fill="#F2622E"/></Canvas></Viewbox></Button>
        <Button Grid.Row="3" Classes="navIcon" Click="RefreshPlaylist_Click" Margin="0,6" HorizontalAlignment="Center" ToolTip.Tip="Listeyi yenile"><Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Data="M17.65,6.35 A8,8 0 1 0 19.73,14 H17.65 A6,6 0 1 1 16.23,8.17 L13,11.4 H21 V3.4 Z" Fill="#F2F4F7"/></Canvas></Viewbox></Button>
        <Button Grid.Row="5" Classes="navIcon" Click="ShowSettings_Click" Margin="0,6" HorizontalAlignment="Center" ToolTip.Tip="Ayarlar"><Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path Data="M19.14,12.94 C19.18,12.63 19.2,12.32 19.2,12 C19.2,11.68 19.18,11.37 19.13,11.06 L21.23,9.42 L19.23,5.96 L16.76,6.96 C16.26,6.57 15.72,6.25 15.12,6.01 L14.74,3.38 H10.74 L10.36,6.01 C9.76,6.25 9.21,6.58 8.72,6.96 L6.25,5.96 L4.25,9.42 L6.35,11.06 C6.3,11.37 6.28,11.69 6.28,12 C6.28,12.32 6.3,12.63 6.35,12.94 L4.25,14.58 L6.25,18.04 L8.72,17.04 C9.21,17.43 9.76,17.75 10.36,17.99 L10.74,20.62 H14.74 L15.12,17.99 C15.72,17.75 16.27,17.42 16.76,17.04 L19.23,18.04 L21.23,14.58 Z M12.74,15.5 A3.5,3.5 0 1 1 12.74,8.5 A3.5,3.5 0 1 1 12.74,15.5" Fill="#F2F4F7"/></Canvas></Viewbox></Button>
        <Button Grid.Row="6" Classes="navIcon" Click="ShowAbout_Click" Margin="0,6" HorizontalAlignment="Center" ToolTip.Tip="Hakkında"><Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path Data="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M12,10 L12,17 M12,7 L12.01,7" Stroke="#F2F4F7" StrokeThickness="1.9" StrokeLineCap="Round"/></Canvas></Viewbox></Button>
      </Grid></Border>
      <Border Grid.Column="1" Background="#171A1F" BorderBrush="#262B33" BorderThickness="0,0,1,0"><Grid RowDefinitions="76,Auto,*">
        <TextBlock x:Name="LibrarySidebarTitle" Text="CANLI TV" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="24,0"/>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="24,14,18,10"><TextBlock Text="Gruplar" Foreground="#A3ABB8"/><Viewbox Grid.Column="1" Width="14" Height="14" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M4,7 H20 M4,12 H20 M4,17 H20" Stroke="#A3ABB8" StrokeThickness="1.8" StrokeLineCap="Round"/></Canvas></Viewbox></Grid>
        <ListBox Grid.Row="2" x:Name="GroupList" SelectionChanged="GroupList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate x:DataType="local:ChannelGroup"><Grid ColumnDefinitions="26,*,Auto" Height="44" Margin="20,0"><Border Width="26" Height="26" CornerRadius="9" Background="#242931"><TextBlock Text="◦" Foreground="#A3ABB8" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Margin="12,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/><TextBlock Grid.Column="2" Text="{Binding Count, StringFormat={}{0:N0}}" FontSize="11" Foreground="#6B7482" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
      </Grid></Border>
    </Grid>

    <Grid x:Name="ContentArea" Grid.Column="1" Background="#14171B" RowDefinitions="76,*" IsVisible="False">
      <Grid x:Name="HeaderPanel" ColumnDefinitions="Auto,*,320" Background="#0F1114">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
          <Button x:Name="LiveSectionButton" Classes="sectionButton active" Click="LiveSection_Click"><StackPanel Orientation="Horizontal" Spacing="9"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M4,5 H20 A2,2 0 0 1 22,7 V17 A2,2 0 0 1 20,19 H4 A2,2 0 0 1 2,17 V7 A2,2 0 0 1 4,5 M8,1 L12,5 L16,1 L17.5,2.5 L15,5 H20 A4,4 0 0 1 24,9 V17 A4,4 0 0 1 20,21 H4 A4,4 0 0 1 0,17 V9 A4,4 0 0 1 4,5 H9 L6.5,2.5 Z M9,9 V15 L15,12 Z" Fill="{Binding $parent[Button].Foreground}"/></Canvas></Viewbox><TextBlock Text="Canlı TV" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="MovieSectionButton" Classes="sectionButton" Click="MovieSection_Click"><StackPanel Orientation="Horizontal" Spacing="9"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M3,4 H21 V7 H3 Z M3,9 H21 V21 H3 Z M5,2 L8,7 H11 L8,2 Z M12,2 L15,7 H18 L15,2 Z M9,12 L9,18 L15,15 Z" Fill="{Binding $parent[Button].Foreground}"/></Canvas></Viewbox><TextBlock Text="Filmler" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="SeriesSectionButton" Classes="sectionButton" Click="SeriesSection_Click"><StackPanel Orientation="Horizontal" Spacing="9"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M6,3 H22 V17 H6 Z M2,7 H4 V19 H18 V21 H2 Z M11,7 V13 L16,10 Z" Fill="{Binding $parent[Button].Foreground}"/></Canvas></Viewbox><TextBlock Text="Diziler" VerticalAlignment="Center"/></StackPanel></Button>
        </StackPanel>
        <Border Grid.Column="2" Height="42" CornerRadius="21" Background="#14171B" BorderBrush="#262B33" BorderThickness="1" Margin="0,0,20,0" VerticalAlignment="Center"><Grid ColumnDefinitions="Auto,*"><Viewbox Width="17" Height="17" Margin="15,0,0,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M10.5,4 A6.5,6.5 0 1 1 10.48,4 M15.4,15.4 L20.5,20.5" Stroke="#6B7482" StrokeThickness="1.9" StrokeLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBox Grid.Column="1" x:Name="SearchBox" Classes="search" Watermark="Bu bölümde ara" TextChanged="SearchBox_TextChanged" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="11,0" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,10,0"/></Grid></Border>
      </Grid>
      <Grid x:Name="ContentBody" Grid.Row="1" ColumnDefinitions="486,*">
        <Border x:Name="ChannelPanel" Background="#14171B" BorderBrush="#262B33" BorderThickness="0,0,1,0"><Grid RowDefinitions="56,*">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="18,0"><Button x:Name="SeriesBackButton" Classes="backButton" Click="SeriesBack_Click" IsVisible="False" Margin="0,0,10,0" ToolTip.Tip="Geri"><Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="M14,5 L7,12 L14,19" Stroke="#F2F4F7" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="Ulusal Kanallar" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="BrowserTitle" Text="KANALLAR" FontSize="9" Foreground="#6B7482"/></StackPanel><TextBlock Grid.Column="2" x:Name="ChannelCount" Text="0 kanal" VerticalAlignment="Center" Foreground="#6B7482" FontSize="10"/><Button Grid.Column="3" x:Name="ClearHistoryButton" Click="ClearRecentHistory_Click" IsVisible="False" Padding="9,5" Margin="8,0,0,0" FontSize="9"><StackPanel Orientation="Horizontal" Spacing="6"><Path Data="M6,7 H18 M9,7 V5 H15 V7 M8,9 V19 H16 V9 M10.5,11 V17 M13.5,11 V17" Stroke="#F2622E" StrokeThickness="1.5" StrokeLineCap="Round" Width="13" Height="13" Stretch="Uniform"/><TextBlock x:Name="ClearHistoryText" Text="Geçmişi Temizle" VerticalAlignment="Center"/></StackPanel></Button></Grid>
          <ListBox Grid.Row="1" x:Name="ChannelList" Classes="cards" SelectionChanged="ChannelList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate x:DataType="local:MediaBrowserItem"><Border Classes="channelCard" Height="116" CornerRadius="16" BorderThickness="1" Margin="14,4" Padding="12"><Grid ColumnDefinitions="132,*,Auto" ToolTip.Tip="{Binding Name}"><local:ChannelLogo Width="132" Height="90" VerticalAlignment="Center" LogoUrl="{Binding LogoUrl}" Initials="{Binding Initials}"/><StackPanel Grid.Column="1" Margin="16,0,10,0" VerticalAlignment="Center" Spacing="7"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="#6B7482" FontSize="11.5" TextTrimming="CharacterEllipsis"/><Border Background="#242931" CornerRadius="7" Padding="8,3" HorizontalAlignment="Left" Margin="0,2,0,0"><TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" Foreground="#A3ABB8"/></Border></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="10"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M12,2.5 L14.9,8.4 L21.4,9.3 L16.7,13.9 L17.8,20.4 L12,17.3 L6.2,20.4 L7.3,13.9 L2.6,9.3 L9.1,8.4 Z" Fill="Transparent" Stroke="#6B7482" StrokeThickness="1.7" StrokeJoin="Round"/></Canvas></Viewbox><Button Classes="historyAction" IsVisible="{Binding CanRemoveFromHistory}" CommandParameter="{Binding Channel}" Click="RemoveRecentItem_Click" HorizontalAlignment="Center"><Viewbox Width="10" Height="10"><Canvas Width="24" Height="24"><Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="#F2F4F7" StrokeThickness="2.4" StrokeLineCap="Round"/></Canvas></Viewbox></Button></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
        </Grid></Border>
        <Border x:Name="PlayerPanel" Grid.Column="1" Background="#08090B" ClipToBounds="True"><Grid x:Name="PlayerSurfaceLayout" ColumnDefinitions="*,0"><Grid x:Name="PlayerLayout" Grid.Column="0" RowDefinitions="*,104">
          <Grid Background="Black"><Border x:Name="PlayerPlaceholder" Background="#08090B"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15"><Border Width="72" Height="72" CornerRadius="24" Background="#1C2026" BorderBrush="#262B33" BorderThickness="1"><Path Data="M7,4 L20,12 L7,20 Z" Fill="#F2622E" Width="26" Height="26" Stretch="Uniform" Margin="4,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="İzlemeye hazır" FontSize="22" FontWeight="Bold"/><TextBlock Text="Bir kanal veya içerik seç" Foreground="#6B7482"/></StackPanel></Border><local:NativeVlcHost x:Name="PlayerView" IsVisible="False"/></Grid>
          <Grid x:Name="PlayerControls" Grid.Row="1" Background="#0F1114" RowDefinitions="Auto,*"><Border Grid.RowSpan="2" Height="1" Background="#1F242B" VerticalAlignment="Top"/><Grid x:Name="TimelinePanel" ColumnDefinitions="*,Auto" IsVisible="False" Margin="22,12,22,0"><Slider x:Name="Timeline" Minimum="0" Maximum="1" Value="0" IsEnabled="False"/><TextBlock Grid.Column="1" x:Name="TimeLabel" Text="CANLI" Foreground="#A3ABB8" FontSize="10" Margin="12,0,0,0"/></Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="22,8,22,12"><Grid ColumnDefinitions="Auto,*" Margin="0,0,16,0"><local:ChannelLogo x:Name="NowPlayingLogo" Width="76" Height="46" VerticalAlignment="Center" Margin="0,0,14,0" IsVisible="False"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><Grid ColumnDefinitions="Auto,*"><Border Background="#40EA2E4E" CornerRadius="100" Padding="8,3" VerticalAlignment="Center" Margin="0,0,9,0"><TextBlock x:Name="PlaybackKindBadge" Text="HAZIR" Foreground="#FF97A6" FontSize="8"/></Border><TextBlock Grid.Column="1" x:Name="NowPlaying" Text="İzlemek için bir kanal seçin" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid><TextBlock x:Name="PlaybackStatus" Text="Hazır" Foreground="#A3ABB8" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid>
              <Border Grid.Column="1" CornerRadius="30" Background="#1C2026" BorderBrush="#262B33" BorderThickness="1" Padding="5" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                <Button x:Name="PreviousChannelButton" Classes="playerAction" Click="PreviousChannel_Click" IsEnabled="False" ToolTip.Tip="Önceki kanal"><Viewbox Width="19" Height="19"><Canvas Width="24" Height="24"><Path Data="M6,5 L6,19 M19,5 L9,12 L19,19 Z" Stroke="#F2F4F7" StrokeThickness="1.8" StrokeLineCap="Round" Fill="Transparent"/></Canvas></Viewbox></Button>
                <Button x:Name="LastChannelButton" Classes="playerAction" Click="LastChannel_Click" IsEnabled="False" ToolTip.Tip="Son kanal"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M4,4 L4,9 L9,9 M5.5,7 A8,8 0 1 1 4.8,15" Stroke="#F2F4F7" StrokeThickness="1.8" StrokeLineCap="Round"/></Canvas></Viewbox></Button>
                <Button x:Name="NextChannelButton" Classes="playerAction" Click="NextChannel_Click" IsEnabled="False" ToolTip.Tip="Sonraki kanal"><Viewbox Width="19" Height="19"><Canvas Width="24" Height="24"><Path Data="M18,5 L18,19 M5,5 L15,12 L5,19 Z" Stroke="#F2F4F7" StrokeThickness="1.8" StrokeLineCap="Round" Fill="Transparent"/></Canvas></Viewbox></Button>
                <Button x:Name="EpgButton" Classes="playerAction" Margin="7,0,0,0" Click="ToggleEpgPanel_Click" IsEnabled="False" ToolTip.Tip="Yayın akışı"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M4,5 L20,5 L20,20 L4,20 Z M8,2 L8,7 M16,2 L16,7 M4,10 L20,10 M8,14 L10,14 M14,14 L16,14 M8,17 L10,17 M14,17 L16,17" Stroke="#F2F4F7" StrokeThickness="1.6" StrokeLineCap="Round"/></Canvas></Viewbox></Button>
                <Button x:Name="FavoriteButton" Classes="playerAction" Click="FavoriteButton_Click" IsEnabled="False" ToolTip.Tip="Favori"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path x:Name="FavoriteOutlineIcon" Data="M12,2.5 L14.9,8.4 L21.4,9.3 L16.7,13.9 L17.8,20.4 L12,17.3 L6.2,20.4 L7.3,13.9 L2.6,9.3 L9.1,8.4 Z" Fill="Transparent" Stroke="#F2F4F7" StrokeThickness="1.8" StrokeJoin="Round"/><Path x:Name="FavoriteFilledIcon" Data="M12,2.5 L14.9,8.4 L21.4,9.3 L16.7,13.9 L17.8,20.4 L12,17.3 L6.2,20.4 L7.3,13.9 L2.6,9.3 L9.1,8.4 Z" Fill="#F2622E" IsVisible="False"/></Canvas></Viewbox></Button>
                <Button x:Name="VolumeButton" Classes="playerAction" Click="VolumeButton_Click" ToolTip.Tip="Ses"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M3,9 L7,9 L12,5 L12,17 L7,13 L3,13 Z" Stroke="#F2F4F7" StrokeThickness="1.7" StrokeLineCap="Round" Fill="Transparent"/><Path x:Name="VolumeWaveIcon" Data="M15,8 C17,10 17,12 15,14 M18,5 C22,9 22,13 18,17" Stroke="#F2F4F7" StrokeThickness="1.7" StrokeLineCap="Round"/><Path x:Name="VolumeMutedIcon" Data="M15,9 L20,14 M20,9 L15,14" Stroke="#EA2E4E" StrokeThickness="1.8" StrokeLineCap="Round" IsVisible="False"/></Canvas></Viewbox></Button>
                <Border CornerRadius="100" Background="#14171B" BorderBrush="#262B33" BorderThickness="1" Height="32" Padding="13,0" VerticalAlignment="Center" Margin="3,0,4,0"><StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center"><Slider x:Name="VolumeSlider" Classes="volume" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeSlider_ValueChanged"/><TextBlock x:Name="VolumeValueText" Text="%80" FontSize="11" FontWeight="SemiBold" Foreground="#A3ABB8" Width="30" TextAlignment="Right" VerticalAlignment="Center"/></StackPanel></Border>
                <Border Width="1" Height="22" Background="#262B33" Margin="7,0" VerticalAlignment="Center"/>
                <Button x:Name="RewindButton" Classes="playerAction" Click="Rewind_Click" IsVisible="False" IsEnabled="False" ToolTip.Tip="10 saniye geri"><Grid><Viewbox Width="23" Height="23"><Canvas Width="24" Height="24"><Path Data="M5,5 L5,10 L10,10 M6,8 A8,8 0 1 1 5,16" Stroke="#F2F4F7" StrokeThickness="1.6" StrokeLineCap="Round"/></Canvas></Viewbox><TextBlock Text="10" FontSize="7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Button>
                <Button x:Name="ForwardButton" Classes="playerAction" Click="Forward_Click" IsVisible="False" IsEnabled="False" ToolTip.Tip="10 saniye ileri"><Grid><Viewbox Width="23" Height="23"><Canvas Width="24" Height="24"><Path Data="M19,5 L19,10 L14,10 M18,8 A8,8 0 1 0 19,16" Stroke="#F2F4F7" StrokeThickness="1.6" StrokeLineCap="Round"/></Canvas></Viewbox><TextBlock Text="10" FontSize="7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Button>
                <Button x:Name="PlayPauseButton" Classes="playerAction primary" Click="PlayPause_Click" IsEnabled="False" ToolTip.Tip="Oynat / duraklat"><Path x:Name="PlayPauseIcon" Data="M3,2 L7,2 L7,18 L3,18 Z M13,2 L17,2 L17,18 L13,18 Z" Fill="#0F1114" Width="17" Height="17" Stretch="Uniform"/></Button>
                <Button x:Name="FullscreenButton" Classes="playerAction" Click="Fullscreen_Click" ToolTip.Tip="Tam ekran"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M4,9 L4,4 L9,4 M15,4 L20,4 L20,9 M20,15 L20,20 L15,20 M9,20 L4,20 L4,15" Stroke="#F2F4F7" StrokeThickness="1.8" StrokeLineCap="Round"/></Canvas></Viewbox></Button>
              </StackPanel></Border>
            </Grid>
          </Grid>
        </Grid>
        <Border x:Name="EpgPanel" Grid.Column="1" IsVisible="False" Background="#171A1F" BorderBrush="#262B33" BorderThickness="1,0,0,0" Padding="18"><Grid RowDefinitions="Auto,Auto,Auto,Auto,*"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="7 GÜNLÜK YAYIN AKIŞI" Foreground="#F2622E" FontSize="9"/><TextBlock x:Name="EpgChannelName" Text="Kanal" FontSize="18" FontWeight="Bold"/></StackPanel><Button Grid.Column="1" Classes="backButton" Click="CloseEpgPanel_Click" ToolTip.Tip="Kapat"><Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="#F2F4F7" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button></Grid><Border Grid.Row="1" Height="1" Background="#262B33" Margin="0,15,0,10"/><Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto"><Button x:Name="EpgPreviousDayButton" Classes="backButton" Click="EpgPreviousDay_Click" ToolTip.Tip="Önceki gün"><Viewbox Width="13" Height="13"><Canvas Width="24" Height="24"><Path Data="M14,5 L7,12 L14,19" Stroke="#F2F4F7" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button><TextBlock Grid.Column="1" x:Name="EpgDateText" Text="BUGÜN" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Grid.Column="2" x:Name="EpgNextDayButton" Classes="backButton" Click="EpgNextDay_Click" ToolTip.Tip="Sonraki gün"><Viewbox Width="13" Height="13"><Canvas Width="24" Height="24"><Path Data="M10,5 L17,12 L10,19" Stroke="#F2F4F7" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button></Grid><TextBox Grid.Row="3" x:Name="EpgSearchBox" Watermark="Program ara..." TextChanged="EpgSearchBox_TextChanged" Margin="0,8"/><Grid Grid.Row="4"><TextBlock x:Name="EpgEmptyText" Text="Bu kanal için yayın akışı bulunamadı." Foreground="#6B7482" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/><ListBox x:Name="EpgProgrammeList" IsVisible="False"><ListBox.ItemTemplate><DataTemplate x:DataType="local:EpgProgrammeItem"><Border Background="{Binding Background}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,4"><Grid ColumnDefinitions="56,*"><TextBlock Text="{Binding TimeText}" Foreground="{Binding TimeForeground}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding Category}" Foreground="#FF8A5C" FontSize="9"/><TextBlock Text="{Binding Description}" Foreground="#8791A0" TextWrapping="Wrap" MaxHeight="38"/><TextBlock Text="{Binding StatusText}" Foreground="#F2622E" FontSize="9" IsVisible="{Binding IsCurrent}"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Grid></Border>
        </Grid></Border>
      </Grid>
    </Grid>

    <Grid x:Name="SettingsPage" Grid.Column="1" Background="#0F1114" IsVisible="False" RowDefinitions="86,*">
      <Grid Margin="30,0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14" VerticalAlignment="Center"><Button Classes="navIcon" Click="HideSettings_Click" ToolTip.Tip="Geri"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M15,5 L8,12 L15,19" Stroke="#F2F4F7" StrokeThickness="1.9" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Ayarlar" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="SettingsSubtitleText" Text="Oynatma Listeleri" FontSize="11" Foreground="#A3ABB8" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="3" Content="Kapat" Click="HideSettings_Click"/></Grid>
      <Grid Grid.Row="1" ColumnDefinitions="252,*">
        <Border Background="#14171B" BorderBrush="#262B33" BorderThickness="0,1,1,0"><StackPanel Margin="14,20" Spacing="4">
          <TextBlock Classes="eyebrow" Text="UYGULAMA" Margin="13,0,0,10"/>
        <Button x:Name="SettingsTabPlaylists" Classes="settingsTab active" Tag="playlists" Click="SettingsTab_Click"><Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center"><Viewbox Width="18" Height="18" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path x:Name="SettingsTabPlaylistsIcon" Data="M4,6 L15,6 M4,12 L15,12 M4,18 L11,18 M19,5 L19,15 M19,15 A2.4,2.4 0 1,1 16.6,15 A2.4,2.4 0 1,1 19,15" Stroke="#A3ABB8" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox><TextBlock Grid.Column="1" Text="Oynatma Listeleri" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left" /></Grid></Button>
        <Button x:Name="SettingsTabGeneral" Classes="settingsTab " Tag="general" Click="SettingsTab_Click"><Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center"><Viewbox Width="18" Height="18" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path x:Name="SettingsTabGeneralIcon" Data="M3,12 A9,9 0 1,1 21,12 A9,9 0 1,1 3,12 M3.4,9 L20.6,9 M3.4,15 L20.6,15 M12,3 C15,6.5 15,17.5 12,21 M12,3 C9,6.5 9,17.5 12,21" Stroke="#A3ABB8" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox><TextBlock Grid.Column="1" Text="Genel" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left" /></Grid></Button>
        <Button x:Name="SettingsTabUpdate" Classes="settingsTab " Tag="update" Click="SettingsTab_Click"><Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center"><Viewbox Width="18" Height="18" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path x:Name="SettingsTabUpdateIcon" Data="M12,4 L12,14.5 M7.8,10.3 L12,14.5 L16.2,10.3 M4.5,19 L19.5,19" Stroke="#A3ABB8" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox><TextBlock Grid.Column="1" Text="Güncelleme" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left" /></Grid></Button>
        <Button x:Name="SettingsTabPrivacy" Classes="settingsTab " Tag="privacy" Click="SettingsTab_Click"><Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center"><Viewbox Width="18" Height="18" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path x:Name="SettingsTabPrivacyIcon" Data="M12,3 L20,6.4 L20,12 C20,16.4 16.6,19.8 12,21.4 C7.4,19.8 4,16.4 4,12 L4,6.4 Z M9,12.2 L11.3,14.5 L15.4,10" Stroke="#A3ABB8" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox><TextBlock Grid.Column="1" Text="Gizlilik" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left" /></Grid></Button>
        <Button x:Name="SettingsTabAbout" Classes="settingsTab " Tag="about" Click="SettingsTab_Click"><Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center"><Viewbox Width="18" Height="18" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path x:Name="SettingsTabAboutIcon" Data="M3,12 A9,9 0 1,1 21,12 A9,9 0 1,1 3,12 M12,11 L12,16.4 M12,7.4 L12,8.2" Stroke="#A3ABB8" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox><TextBlock Grid.Column="1" Text="Hakkında" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left" /></Grid></Button>
        </StackPanel></Border>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid Margin="34,26,34,36" MaxWidth="1000" HorizontalAlignment="Stretch">
          <StackPanel x:Name="SettingsSectionPlaylists" Spacing="16"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Classes="sectionTitle" Text="Oynatma Listeleri"/><TextBlock Classes="cardHint" Text="M3U, dosya veya Xtream hesabı ekleyin."/></StackPanel><Button Grid.Column="1" Content="Dosyadan ekle" Click="AddPlaylistFile_Click" VerticalAlignment="Center"/></Grid><Border Classes="card"><StackPanel Spacing="14"><TextBlock Classes="eyebrow" Text="M3U URL EKLE"/><Grid ColumnDefinitions="200,*,Auto" ColumnSpacing="10"><TextBox x:Name="PlaylistNameBox" Watermark="Liste adı"/><TextBox Grid.Column="1" x:Name="PlaylistUrlBox" Watermark="https://ornek.com/playlist.m3u"/><Button Grid.Column="2" Click="AddPlaylistUrl_Click"><StackPanel Orientation="Horizontal" Spacing="8"><Viewbox Width="13" Height="13"><Canvas Width="24" Height="24"><Path Data="M12,5 L12,19 M5,12 L19,12" Stroke="#F2F4F7" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox><TextBlock Text="Ekle"/></StackPanel></Button></Grid></StackPanel></Border><Border Classes="card"><StackPanel Spacing="14"><TextBlock Classes="eyebrow" Text="XTREAM HESABI EKLE"/><Grid ColumnDefinitions="170,*,170,170,Auto" ColumnSpacing="10"><TextBox x:Name="XtreamNameBox" Watermark="Hesap adı"/><TextBox Grid.Column="1" x:Name="XtreamServerBox" Watermark="http://sunucu:port"/><TextBox Grid.Column="2" x:Name="XtreamUsernameBox" Watermark="Kullanıcı adı"/><TextBox Grid.Column="3" x:Name="XtreamPasswordBox" Watermark="Şifre" PasswordChar="●"/><Button Grid.Column="4" Click="AddXtreamPlaylist_Click"><StackPanel Orientation="Horizontal" Spacing="8"><Viewbox Width="13" Height="13"><Canvas Width="24" Height="24"><Path Data="M12,5 L12,19 M5,12 L19,12" Stroke="#F2F4F7" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox><TextBlock Text="Xtream Ekle"/></StackPanel></Button></Grid></StackPanel></Border><Border Classes="card" Padding="22,20,22,14"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Classes="eyebrow" Text="KAYITLI LİSTELER"/><TextBlock Grid.Column="1" x:Name="PlaylistCountText" Classes="eyebrow" Foreground="#A3ABB8"/></Grid><ListBox x:Name="PlaylistSettingsList" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate x:DataType="local:PlaylistEntry"><Border Background="#1C2026" BorderBrush="#262B33" BorderThickness="1" CornerRadius="14" Padding="16,13" Margin="0,0,0,8"><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8"><StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DisplayPath}" FontSize="11" Foreground="#6B7482" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Content="Yenile" Click="RefreshSavedPlaylist_Click" CommandParameter="{Binding}" VerticalAlignment="Center"/><Button Grid.Column="2" Content="{Binding ActiveText}" Click="ActivatePlaylist_Click" CommandParameter="{Binding}" VerticalAlignment="Center"/><Button Grid.Column="3" Content="Kaldır" Click="RemovePlaylist_Click" CommandParameter="{Binding}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border></StackPanel>
          <StackPanel x:Name="SettingsSectionGeneral" Spacing="16" IsVisible="False"><StackPanel Spacing="6"><TextBlock Classes="sectionTitle" Text="Genel"/><TextBlock Classes="cardHint" Text="Uygulama dilini seçin. Değişiklik anında uygulanır."/></StackPanel><Border Classes="card"><StackPanel Spacing="16"><TextBlock Classes="cardTitle" Text="Arayüz dili"/><Grid ColumnDefinitions="*,*" ColumnSpacing="14"><Button x:Name="LanguageTurkishButton" Classes="optionCard active" Tag="tr" Click="SetLanguage_Click"><Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center"><Border Width="42" Height="42" CornerRadius="12" Background="#242931"><TextBlock Text="TR" FontSize="13" FontWeight="Bold" Foreground="#FF8A5C" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center"><TextBlock Text="Türkçe" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Left" TextAlignment="Left"/><TextBlock Text="Varsayılan" FontSize="11" Foreground="#6B7482" Margin="0,3,0,0" HorizontalAlignment="Left" TextAlignment="Left"/></StackPanel><Viewbox Grid.Column="2" x:Name="LanguageTurkishCheck" Width="19" Height="19" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M4,12.6 L9.4,18 L20,7" Stroke="#F2622E" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Grid></Button><Button Grid.Column="1" x:Name="LanguageEnglishButton" Classes="optionCard" Tag="en" Click="SetLanguage_Click"><Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center"><Border Width="42" Height="42" CornerRadius="12" Background="#242931"><TextBlock Text="EN" FontSize="13" FontWeight="Bold" Foreground="#A3ABB8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center"><TextBlock Text="English" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Left" TextAlignment="Left"/><TextBlock Text="United Kingdom" FontSize="11" Foreground="#6B7482" Margin="0,3,0,0" HorizontalAlignment="Left" TextAlignment="Left"/></StackPanel><Viewbox Grid.Column="2" x:Name="LanguageEnglishCheck" Width="19" Height="19" VerticalAlignment="Center" IsVisible="False"><Canvas Width="24" Height="24"><Path Data="M4,12.6 L9.4,18 L20,7" Stroke="#F2622E" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Grid></Button></Grid><TextBlock Classes="cardHint" Text="Kanal, film ve dizi adları oynatma listenizden geldiği için çevrilmez."/></StackPanel></Border></StackPanel>
          <StackPanel x:Name="SettingsSectionUpdate" Spacing="16" IsVisible="False"><StackPanel Spacing="6"><TextBlock Classes="sectionTitle" Text="Güncelleme"/><TextBlock Classes="cardHint" Text="Uygulama her açılışta güncellemeleri kendiliğinden denetler."/></StackPanel><Border Classes="card"><StackPanel Spacing="18"><Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center"><Border Width="52" Height="52" CornerRadius="15" Background="#26F2622E"><Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Data="M12,4 L12,14.5 M7.8,10.3 L12,14.5 L16.2,10.3 M4.5,19 L19.5,19" Stroke="#F2622E" StrokeThickness="1.7" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox></Border><StackPanel Grid.Column="1" Margin="16,0,14,0" VerticalAlignment="Center"><TextBlock Classes="cardTitle" Text="Yüklü sürüm"/><TextBlock x:Name="SettingsVersionText" Text="1.0.0" FontSize="12" Foreground="#A3ABB8" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="2" x:Name="CheckUpdatesButton" Content="Güncellemeleri denetle" Click="CheckUpdatesNow_Click" VerticalAlignment="Center"/></Grid><Border Height="1" Background="#262B33"/><StackPanel Spacing="14"><TextBlock x:Name="SettingsUpdateStatus" Classes="cardHint" Text="Güncellemeleri denetle"/><StackPanel x:Name="SettingsUpdateActions" Orientation="Horizontal" Spacing="10" IsVisible="False"><Button x:Name="SettingsUpdateNowButton" Content="Şimdi güncelle" Click="UpdateNow_Click"/><Button Classes="linkButton" Content="Sürüm notlarını aç" Click="OpenUpdate_Click" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel></StackPanel></StackPanel></Border><Border Classes="card"><StackPanel Spacing="12"><TextBlock Classes="cardTitle" Text="Güvenli güncelleme"/><TextBlock Classes="cardHint" Text="Güncellemeler yalnızca projenin resmî GitHub sürüm sayfasından indirilir."/><TextBlock Classes="cardHint" Text="İndirilip kurulur, ardından uygulama yeniden başlar."/></StackPanel></Border></StackPanel>
          <StackPanel x:Name="SettingsSectionPrivacy" Spacing="16" IsVisible="False"><StackPanel Spacing="6"><TextBlock Classes="sectionTitle" Text="Gizlilik"/><TextBlock Classes="cardHint" Text="Verileriniz cihazınızda kalır"/></StackPanel><Border Classes="card"><Grid ColumnDefinitions="Auto,*"><Border Width="52" Height="52" CornerRadius="15" Background="#26F2622E" VerticalAlignment="Top"><Viewbox Width="25" Height="25"><Canvas Width="24" Height="24"><Path Data="M12,3 L20,6.4 L20,12 C20,16.4 16.6,19.8 12,21.4 C7.4,19.8 4,16.4 4,12 L4,6.4 Z M9,12.2 L11.3,14.5 L15.4,10" Stroke="#F2622E" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox></Border><StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="8" VerticalAlignment="Center"><TextBlock Classes="cardTitle" Text="Verileriniz cihazınızda kalır"/><TextBlock Classes="cardHint" Text="Uygulama hesap açmanızı istemez, kullanım verisi toplamaz ve içeriklerinizi hiçbir sunucuya göndermez."/></StackPanel></Grid></Border><Border Classes="card"><StackPanel Spacing="14"><TextBlock Classes="cardTitle" Text="Cihazda saklananlar"/><StackPanel Spacing="9"><Grid ColumnDefinitions="Auto,*"><Border Width="6" Height="6" CornerRadius="3" Background="#F2622E" VerticalAlignment="Center" Margin="1,0,0,0"/><TextBlock Grid.Column="1" Classes="cardHint" Text="Oynatma listesi adresleri ve Xtream hesap bilgileri" Margin="13,0,0,0"/></Grid><Grid ColumnDefinitions="Auto,*"><Border Width="6" Height="6" CornerRadius="3" Background="#F2622E" VerticalAlignment="Center" Margin="1,0,0,0"/><TextBlock Grid.Column="1" Classes="cardHint" Text="İzleme geçmişi, favoriler ve kaldığınız konum" Margin="13,0,0,0"/></Grid><Grid ColumnDefinitions="Auto,*"><Border Width="6" Height="6" CornerRadius="3" Background="#F2622E" VerticalAlignment="Center" Margin="1,0,0,0"/><TextBlock Grid.Column="1" Classes="cardHint" Text="Liste ve yayın akışı önbelleği" Margin="13,0,0,0"/></Grid></StackPanel><Border Height="1" Background="#262B33"/><StackPanel Spacing="8"><TextBlock Classes="eyebrow" Text="VERİ KLASÖRÜ"/><TextBlock x:Name="SettingsDataPathText" Classes="cardHint" Foreground="#6B7482" FontSize="11.5" Text=""/></StackPanel><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Klasörü aç" Click="OpenDataFolder_Click"/><Button Content="İzleme geçmişini temizle" Click="ClearWatchData_Click"/><Button Content="Önbelleği temizle" Click="ClearCacheData_Click"/></StackPanel><TextBlock x:Name="SettingsPrivacyStatus" Classes="cardHint" Foreground="#FF8A5C" Text="" IsVisible="False"/></StackPanel></Border><Border Classes="card"><StackPanel Spacing="12"><TextBlock Classes="cardTitle" Text="Ağ bağlantıları"/><TextBlock Classes="cardHint" Text="Yalnızca sizin eklediğiniz liste sunucularına, yayın kaynaklarına ve sürüm denetimi için GitHub sayfasına bağlanılır."/><Button Classes="linkButton" Content="Gizlilik metnini aç" Click="OpenPrivacy_Click" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel>
          <StackPanel x:Name="SettingsSectionAbout" Spacing="16" IsVisible="False"><StackPanel Spacing="6"><TextBlock Classes="sectionTitle" Text="Hakkında"/><TextBlock Classes="cardHint" Text="Geliştiren: Berk Güçlükol"/></StackPanel><Border Classes="card" Padding="26"><StackPanel Spacing="20"><Grid ColumnDefinitions="Auto,*"><Image Source="avares://BG-IPTV-Player/Assets/app-icon.png" Width="76" Height="76" VerticalAlignment="Top"/><StackPanel Grid.Column="1" Margin="20,2,0,0" Spacing="7"><TextBlock Text="BG IPTV Player" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="AboutVersionText" Text="Sürüm 1.0.0" FontSize="12.5" Foreground="#F2622E" FontWeight="SemiBold"/><TextBlock Classes="cardHint" Text="M3U ve IPTV listelerini uygulama içinde oynatmak için geliştirilmiş Windows masaüstü uygulaması." Margin="0,4,0,0" MaxWidth="520" HorizontalAlignment="Left"/></StackPanel></Grid><Border Height="1" Background="#262B33"/><Grid ColumnDefinitions="*,*" ColumnSpacing="18"><StackPanel Spacing="7"><TextBlock Classes="eyebrow" Text="GELİŞTİREN"/><TextBlock Text="Berk Güçlükol" FontSize="13"/></StackPanel><StackPanel Grid.Column="1" Spacing="7"><TextBlock Classes="eyebrow" Text="KULLANILAN TEKNOLOJİLER"/><TextBlock Text="Avalonia UI · LibVLC · .NET 8" FontSize="13"/></StackPanel></Grid><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Web Sitesi" Click="OpenHomepage_Click"/><Button Content="GitHub" Click="OpenGithub_Click"/><Button Content="Gizlilik" Click="OpenPrivacy_Click"/></StackPanel></StackPanel></Border></StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Border x:Name="UpdateBanner" Grid.Column="1" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="38,20" Padding="18,14" Background="#1C2026" BorderBrush="#F2622E" BorderThickness="1" CornerRadius="16" MaxWidth="520"><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="14"><StackPanel VerticalAlignment="Center" MaxWidth="250"><TextBlock x:Name="UpdateTitle" Text="Yeni sürüm hazır" FontWeight="SemiBold"/><TextBlock x:Name="UpdateStatusText" Text="İndirilip kurulur, ardından uygulama yeniden başlar." FontSize="11" Foreground="#A3ABB8" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" x:Name="UpdateNowButton" Content="Güncelle" Click="UpdateNow_Click" VerticalAlignment="Center"/><Button Grid.Column="2" Classes="linkButton" Content="Notlar" Click="OpenUpdate_Click" VerticalAlignment="Center"/><Button Grid.Column="3" Classes="backButton" Click="DismissUpdate_Click" VerticalAlignment="Center" ToolTip.Tip="Kapat"><Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="#F2F4F7" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button></Grid></Border>
      <Grid x:Name="LoadingOverlay" Grid.Column="0" Grid.ColumnSpan="2" Background="#0F1114">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" Width="340">
          <Image Source="avares://BG-IPTV-Player/Assets/app-icon.png" Height="86" HorizontalAlignment="Center"/>
          <StackPanel Spacing="8">
            <TextBlock Text="BG IPTV Player" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="LoadingStatusText" Text="Oynatma listesi hazırlanıyor..." FontSize="12.5" Foreground="#A3ABB8" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <ProgressBar IsIndeterminate="True" Height="4" Width="240" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
  </Grid>
</Window>
