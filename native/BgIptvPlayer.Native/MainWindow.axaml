<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BgIptvPlayer.Native"
        x:Class="BgIptvPlayer.Native.MainWindow" Title="BG IPTV Player" Icon="avares://BG-IPTV-Player/Assets/app-icon.png"
        Width="1500" Height="900" MinWidth="1120" MinHeight="700" Background="#191316" Foreground="#FFFFFF"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter" KeyDown="Window_KeyDown" PointerMoved="Window_PointerMoved">
  <Window.Styles>
    <Style Selector="Button"><Setter Property="Background" Value="#2A2124"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#463739"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="16,11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/></Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="#342A2D"/><Setter Property="BorderBrush" Value="#574548"/></Style>
    <Style Selector="Button.navIcon"><Setter Property="Width" Value="50"/><Setter Property="Height" Value="50"/><Setter Property="CornerRadius" Value="25"/><Setter Property="Padding" Value="14"/><Setter Property="Background" Value="#2A2124"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.navIcon:pointerover"><Setter Property="Background" Value="#342A2D"/></Style>
    <Style Selector="Button.navIcon.active"><Setter Property="Background" Value="#403233"/><Setter Property="BorderBrush" Value="#EE5A3C"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.sectionButton"><Setter Property="Height" Value="46"/><Setter Property="Width" Value="126"/><Setter Property="Padding" Value="15,0"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="CornerRadius" Value="23"/><Setter Property="Background" Value="#211A1D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#332729"/><Setter Property="Foreground" Value="#C9B7B3"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.sectionButton:pointerover"><Setter Property="Background" Value="#342A2D"/><Setter Property="BorderBrush" Value="#574548"/><Setter Property="Foreground" Value="#FFFFFF"/></Style>
    <Style Selector="Button.sectionButton.active"><Setter Property="Background" Value="#33EE5A3C"/><Setter Property="Foreground" Value="#FF8A6B"/><Setter Property="BorderBrush" Value="#EE5A3C"/></Style>
    <Style Selector="Button.playerAction"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.playerAction:pointerover"><Setter Property="Background" Value="#403233"/></Style>
    <Style Selector="Button.playerAction.primary"><Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/><Setter Property="CornerRadius" Value="24"/><Setter Property="Background" Value="#EE5A3C"/><Setter Property="BorderBrush" Value="#FF8A6B"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.playerAction.primary:pointerover"><Setter Property="Background" Value="#F4795E"/></Style>
    <Style Selector="Button.backButton"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Background" Value="#342A2D"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.historyAction"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Background" Value="#342A2D"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.linkButton"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="#C9B7B3"/><Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.linkButton:pointerover"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#EE5A3C"/></Style>
    <Style Selector="TextBox"><Setter Property="Background" Value="#211A1D"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#463739"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="15,11"/></Style>
    <Style Selector="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="CornerRadius" Value="0"/></Style>
    <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="#342A2D"/></Style>
    <Style Selector="ListBoxItem:selected /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="#342A2D"/></Style>
    <Style Selector="ListBoxItem:pointerover"><Setter Property="Background" Value="#221B1E"/></Style>
    <Style Selector="Slider"><Setter Property="Foreground" Value="#EE5A3C"/></Style>
    <Style Selector="Slider.volume"><Setter Property="Width" Value="72"/><Setter Property="Height" Value="22"/><Setter Property="MinHeight" Value="0"/><Setter Property="Margin" Value="4,0,2,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style Selector="Slider.volume /template/ Thumb"><Setter Property="Width" Value="13"/><Setter Property="Height" Value="13"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#FFFFFF"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Slider.volume /template/ Border#TrackBackground"><Setter Property="Height" Value="4"/><Setter Property="MinHeight" Value="0"/><Setter Property="CornerRadius" Value="2"/><Setter Property="Background" Value="#463739"/></Style>
    <Style Selector="Slider.volume /template/ RepeatButton"><Setter Property="MinHeight" Value="0"/></Style>
    <Style Selector="ProgressBar"><Setter Property="Foreground" Value="#EE5A3C"/><Setter Property="Background" Value="#403233"/><Setter Property="CornerRadius" Value="2"/></Style>
  </Window.Styles>

  <Grid x:Name="RootGrid" ColumnDefinitions="0,*">
    <Grid x:Name="HomePage" Grid.Column="1" Background="#191316" RowDefinitions="86,*,Auto" IsVisible="True">
      <Grid Margin="34,0" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="16" VerticalAlignment="Center">
        <Image Source="avares://BG-IPTV-Player/Assets/app-icon.png" Height="34" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="BG IPTV Player" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        <Border Grid.Column="2" Width="330" Height="42" CornerRadius="21" Background="#2A2124" BorderBrush="#463739" BorderThickness="1" VerticalAlignment="Center"><Grid ColumnDefinitions="Auto,*"><Viewbox Width="17" Height="17" Margin="15,0,0,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M10.5,4 A6.5,6.5 0 1 1 10.48,4 M15.4,15.4 L20.5,20.5" Stroke="#8E7A78" StrokeThickness="1.9" StrokeLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBox Grid.Column="1" x:Name="HomeSearchBox" Watermark="Tüm içerikte ara" KeyDown="HomeSearchBox_KeyDown" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="11,0" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,10,0"/></Grid></Border>
        <StackPanel Grid.Column="4" VerticalAlignment="Center">
          <TextBlock x:Name="HomeTimeText" Text="00:00" FontSize="19" FontWeight="Bold" HorizontalAlignment="Right"/>
          <TextBlock x:Name="HomeDateText" Text="" FontSize="11" Foreground="#C9B7B3" HorizontalAlignment="Right" Margin="0,4,0,0"/>
        </StackPanel>
        <Button Grid.Column="5" Classes="navIcon" VerticalAlignment="Center" Click="ShowSettingsFromHome_Click" ToolTip.Tip="Ayarlar"><Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path Data="M19.14,12.94 C19.18,12.63 19.2,12.32 19.2,12 C19.2,11.68 19.18,11.37 19.13,11.06 L21.23,9.42 L19.23,5.96 L16.76,6.96 C16.26,6.57 15.72,6.25 15.12,6.01 L14.74,3.38 H10.74 L10.36,6.01 C9.76,6.25 9.21,6.58 8.72,6.96 L6.25,5.96 L4.25,9.42 L6.35,11.06 C6.3,11.37 6.28,11.69 6.28,12 C6.28,12.32 6.3,12.63 6.35,12.94 L4.25,14.58 L6.25,18.04 L8.72,17.04 C9.21,17.43 9.76,17.75 10.36,17.99 L10.74,20.62 H14.74 L15.12,17.99 C15.72,17.75 16.27,17.42 16.76,17.04 L19.23,18.04 L21.23,14.58 Z M12.74,15.5 A3.5,3.5 0 1 1 12.74,8.5 A3.5,3.5 0 1 1 12.74,15.5" Fill="#FFFFFF"/></Canvas></Viewbox></Button>
        <Button Grid.Column="6" Classes="navIcon" VerticalAlignment="Center" Click="ShowAboutFromHome_Click" ToolTip.Tip="Hakkında"><Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path Data="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M12,10 L12,17 M12,7 L12.01,7" Stroke="#FFFFFF" StrokeThickness="1.9" StrokeLineCap="Round"/></Canvas></Viewbox></Button>
      </Grid>
      <Grid Grid.Row="1" Margin="28,0,28,18" ColumnDefinitions="*,*,*" ColumnSpacing="18">
        <Button Grid.Column="0" Click="HomeLive_Click" Padding="26" CornerRadius="22" BorderThickness="0" ClipToBounds="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <Button.Background><RadialGradientBrush Center="80%,10%" GradientOrigin="80%,10%" RadiusX="100%" RadiusY="100%"><GradientStop Color="#4DE0731C" Offset="0"/><GradientStop Color="#002A2124" Offset="1"/></RadialGradientBrush></Button.Background>
          <Grid>
            <Viewbox Stretch="UniformToFill" Margin="-26" Opacity="0.55">
              <Canvas Width="400" Height="560">
                <Ellipse Canvas.Left="10" Canvas.Top="150" Width="640" Height="640" Stroke="#E0731C" StrokeThickness="2" Opacity="0.16"/>
                <Ellipse Canvas.Left="75" Canvas.Top="215" Width="510" Height="510" Stroke="#E0731C" StrokeThickness="2" Opacity="0.24"/>
                <Ellipse Canvas.Left="135" Canvas.Top="275" Width="390" Height="390" Stroke="#E0731C" StrokeThickness="2" Opacity="0.34"/>
                <Ellipse Canvas.Left="190" Canvas.Top="330" Width="280" Height="280" Stroke="#F09A4A" StrokeThickness="2.5" Opacity="0.46"/>
                <Ellipse Canvas.Left="240" Canvas.Top="380" Width="180" Height="180" Stroke="#F09A4A" StrokeThickness="2.5" Opacity="0.6"/>
                <Ellipse Canvas.Left="316" Canvas.Top="456" Width="28" Height="28" Fill="#F09A4A" Opacity="0.75"/>
              </Canvas>
            </Viewbox>
            <Viewbox Width="46" Height="46" HorizontalAlignment="Left" VerticalAlignment="Top"><Canvas Width="24" Height="24"><Path Data="M4,6 L20,6 L20,18 L4,18 Z M8,22 L16,22 M12,18 L12,22 M8,2 L12,6 L16,2" Stroke="#FFFFFF" StrokeThickness="1.4" StrokeLineCap="Round"/><Path Data="M9,10 L15,12 L9,14 Z" Fill="#EE5A3C"/></Canvas></Viewbox>
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Spacing="5">
              <TextBlock x:Name="HomeLiveCount" Text="0 kanal" FontSize="11" FontWeight="Bold" Foreground="#EE5A3C" HorizontalAlignment="Left" TextAlignment="Left"/>
              <TextBlock Text="Canlı TV" FontSize="22" FontWeight="Bold" HorizontalAlignment="Left" TextAlignment="Left"/>
            </StackPanel>
          </Grid>
        </Button>
        <Button Grid.Column="1" Click="HomeMovie_Click" Padding="26" CornerRadius="22" BorderThickness="0" ClipToBounds="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <Button.Background><RadialGradientBrush Center="80%,10%" GradientOrigin="80%,10%" RadiusX="100%" RadiusY="100%"><GradientStop Color="#4DEE5A3C" Offset="0"/><GradientStop Color="#002A2124" Offset="1"/></RadialGradientBrush></Button.Background>
          <Grid>
            <Viewbox Stretch="UniformToFill" Margin="-26" Opacity="0.55">
              <Canvas Width="400" Height="560">
                <Path Data="M-30,150 L430,320 L430,410 L-30,240 Z" Opacity="0.5">
                  <Path.Fill>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                      <GradientStop Color="#00EE5A3C" Offset="0"/>
                      <GradientStop Color="#80FF8A6B" Offset="1"/>
                    </LinearGradientBrush>
                  </Path.Fill>
                </Path>
                <Path Data="M-30,330 L430,180 L430,238 L-30,388 Z" Opacity="0.28">
                  <Path.Fill>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                      <GradientStop Color="#00EE5A3C" Offset="0"/>
                      <GradientStop Color="#66EE5A3C" Offset="1"/>
                    </LinearGradientBrush>
                  </Path.Fill>
                </Path>
                <Rectangle Canvas.Left="306" Canvas.Top="-20" Width="3" Height="600" Fill="#EE5A3C" Opacity="0.22"/>
                <Rectangle Canvas.Left="392" Canvas.Top="-20" Width="3" Height="600" Fill="#EE5A3C" Opacity="0.22"/>
                <Rectangle Canvas.Left="330" Canvas.Top="30" Width="42" Height="52" RadiusX="9" RadiusY="9" Stroke="#FF8A6B" StrokeThickness="2.5" Opacity="0.3"/>
                <Rectangle Canvas.Left="330" Canvas.Top="112" Width="42" Height="52" RadiusX="9" RadiusY="9" Stroke="#FF8A6B" StrokeThickness="2.5" Opacity="0.3"/>
                <Rectangle Canvas.Left="330" Canvas.Top="194" Width="42" Height="52" RadiusX="9" RadiusY="9" Stroke="#FF8A6B" StrokeThickness="2.5" Opacity="0.3"/>
                <Rectangle Canvas.Left="330" Canvas.Top="276" Width="42" Height="52" RadiusX="9" RadiusY="9" Stroke="#FF8A6B" StrokeThickness="2.5" Opacity="0.3"/>
                <Rectangle Canvas.Left="330" Canvas.Top="358" Width="42" Height="52" RadiusX="9" RadiusY="9" Stroke="#FF8A6B" StrokeThickness="2.5" Opacity="0.3"/>
                <Rectangle Canvas.Left="330" Canvas.Top="440" Width="42" Height="52" RadiusX="9" RadiusY="9" Stroke="#FF8A6B" StrokeThickness="2.5" Opacity="0.3"/>
              </Canvas>
            </Viewbox>
            <Viewbox Width="46" Height="46" HorizontalAlignment="Left" VerticalAlignment="Top"><Canvas Width="24" Height="24"><Path Data="M3,8 L21,8 L21,20 L3,20 Z M3,8 L5,3 L21,3 L19,8 M8,3 L6,8 M14,3 L12,8 M20,3 L18,8" Stroke="#FFFFFF" StrokeThickness="1.4" StrokeJoin="Round"/><Path Data="M10,11 L16,14 L10,17 Z" Fill="#EE5A3C"/></Canvas></Viewbox>
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Spacing="5">
              <TextBlock x:Name="HomeMovieCount" Text="0 film" FontSize="11" FontWeight="Bold" Foreground="#EE5A3C" HorizontalAlignment="Left" TextAlignment="Left"/>
              <TextBlock Text="Filmler" FontSize="22" FontWeight="Bold" HorizontalAlignment="Left" TextAlignment="Left"/>
            </StackPanel>
          </Grid>
        </Button>
        <Button Grid.Column="2" Click="HomeSeries_Click" Padding="26" CornerRadius="22" BorderThickness="0" ClipToBounds="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <Button.Background><RadialGradientBrush Center="80%,10%" GradientOrigin="80%,10%" RadiusX="100%" RadiusY="100%"><GradientStop Color="#4DE8324A" Offset="0"/><GradientStop Color="#002A2124" Offset="1"/></RadialGradientBrush></Button.Background>
          <Grid>
            <Viewbox Stretch="UniformToFill" Margin="-26" Opacity="0.55">
              <Canvas Width="400" Height="560">
                <Rectangle Canvas.Left="236" Canvas.Top="292" Width="230" Height="150" RadiusX="20" RadiusY="20" Stroke="#E8324A" StrokeThickness="2.5" Opacity="0.18"/>
                <Rectangle Canvas.Left="206" Canvas.Top="240" Width="230" Height="150" RadiusX="20" RadiusY="20" Stroke="#E8324A" StrokeThickness="2.5" Opacity="0.34"/>
                <Rectangle Canvas.Left="176" Canvas.Top="188" Width="230" Height="150" RadiusX="20" RadiusY="20" Stroke="#F26178" StrokeThickness="2.5" Opacity="0.55"/>
                <Path Data="M272,238 L308,263 L272,288 Z" Fill="#F26178" Opacity="0.5"/>
                <Ellipse Canvas.Left="48" Canvas.Top="430" Width="14" Height="14" Fill="#E8324A" Opacity="0.32"/>
                <Ellipse Canvas.Left="92" Canvas.Top="430" Width="14" Height="14" Fill="#E8324A" Opacity="0.26"/>
                <Ellipse Canvas.Left="136" Canvas.Top="430" Width="14" Height="14" Fill="#E8324A" Opacity="0.2"/>
                <Ellipse Canvas.Left="48" Canvas.Top="474" Width="14" Height="14" Fill="#E8324A" Opacity="0.26"/>
                <Ellipse Canvas.Left="92" Canvas.Top="474" Width="14" Height="14" Fill="#E8324A" Opacity="0.2"/>
                <Ellipse Canvas.Left="136" Canvas.Top="474" Width="14" Height="14" Fill="#E8324A" Opacity="0.14"/>
              </Canvas>
            </Viewbox>
            <Viewbox Width="46" Height="46" HorizontalAlignment="Left" VerticalAlignment="Top"><Canvas Width="24" Height="24"><Path Data="M7,3 L21,3 L21,17 L7,17 Z M3,7 L3,21 L17,21" Stroke="#FFFFFF" StrokeThickness="1.4" StrokeJoin="Round"/><Path Data="M12,7 L17,10 L12,13 Z" Fill="#EE5A3C"/></Canvas></Viewbox>
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Spacing="5">
              <TextBlock x:Name="HomeSeriesCount" Text="0 dizi" FontSize="11" FontWeight="Bold" Foreground="#EE5A3C" HorizontalAlignment="Left" TextAlignment="Left"/>
              <TextBlock Text="Diziler" FontSize="22" FontWeight="Bold" HorizontalAlignment="Left" TextAlignment="Left"/>
            </StackPanel>
          </Grid>
        </Button>
      </Grid>
      <Border Grid.Row="2" Height="54" BorderBrush="#463739" BorderThickness="0,1,0,0" Margin="28,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock x:Name="HomeVersionText" Text="BG IPTV Player" FontSize="11.5" Foreground="#8E7A78" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="22" VerticalAlignment="Center">
            <Button Classes="linkButton" Content="Hakkında" Click="ShowAboutFromHome_Click"/>
            <Button Classes="linkButton" Content="Gizlilik" Click="OpenPrivacy_Click"/>
            <Button Classes="linkButton" Content="Web Sitesi" Click="OpenHomepage_Click"/>
            <Button Classes="linkButton" Content="GitHub" Click="OpenGithub_Click"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="Sidebar" Grid.Column="0" ColumnDefinitions="92,*" IsVisible="False">
      <Border Background="#211A1D" BorderBrush="#463739" BorderThickness="0,0,1,0"><Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" Margin="0,18">
        <Image Source="avares://BG-IPTV-Player/Assets/app-icon.png" Height="36" HorizontalAlignment="Center"/>
        <Button Grid.Row="1" Classes="navIcon" Click="BackHome_Click" Margin="0,24,0,12" HorizontalAlignment="Center" ToolTip.Tip="Ana ekran"><Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Data="M15.4,4 L7.4,12 L15.4,20 L17.5,17.9 L11.6,12 L17.5,6.1 Z" Fill="#FFFFFF"/></Canvas></Viewbox></Button>
        <Button Grid.Row="2" Classes="navIcon active" Click="LiveSection_Click" Margin="0,6" HorizontalAlignment="Center" ToolTip.Tip="Canlı TV"><Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Data="M4,5 H20 A2,2 0 0 1 22,7 V17 A2,2 0 0 1 20,19 H4 A2,2 0 0 1 2,17 V7 A2,2 0 0 1 4,5 M8,1 L12,5 L16,1 L17.5,2.5 L15,5 H9 L6.5,2.5 Z M9,9 V15 L15,12 Z" Fill="#EE5A3C"/></Canvas></Viewbox></Button>
        <Button Grid.Row="3" Classes="navIcon" Click="RefreshPlaylist_Click" Margin="0,6" HorizontalAlignment="Center" ToolTip.Tip="Listeyi yenile"><Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Data="M17.65,6.35 A8,8 0 1 0 19.73,14 H17.65 A6,6 0 1 1 16.23,8.17 L13,11.4 H21 V3.4 Z" Fill="#FFFFFF"/></Canvas></Viewbox></Button>
        <Button Grid.Row="5" Classes="navIcon" Click="ShowSettings_Click" Margin="0,6" HorizontalAlignment="Center" ToolTip.Tip="Ayarlar"><Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path Data="M19.14,12.94 C19.18,12.63 19.2,12.32 19.2,12 C19.2,11.68 19.18,11.37 19.13,11.06 L21.23,9.42 L19.23,5.96 L16.76,6.96 C16.26,6.57 15.72,6.25 15.12,6.01 L14.74,3.38 H10.74 L10.36,6.01 C9.76,6.25 9.21,6.58 8.72,6.96 L6.25,5.96 L4.25,9.42 L6.35,11.06 C6.3,11.37 6.28,11.69 6.28,12 C6.28,12.32 6.3,12.63 6.35,12.94 L4.25,14.58 L6.25,18.04 L8.72,17.04 C9.21,17.43 9.76,17.75 10.36,17.99 L10.74,20.62 H14.74 L15.12,17.99 C15.72,17.75 16.27,17.42 16.76,17.04 L19.23,18.04 L21.23,14.58 Z M12.74,15.5 A3.5,3.5 0 1 1 12.74,8.5 A3.5,3.5 0 1 1 12.74,15.5" Fill="#FFFFFF"/></Canvas></Viewbox></Button>
        <Button Grid.Row="6" Classes="navIcon" Click="ShowAbout_Click" Margin="0,6" HorizontalAlignment="Center" ToolTip.Tip="Hakkında"><Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path Data="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M12,10 L12,17 M12,7 L12.01,7" Stroke="#FFFFFF" StrokeThickness="1.9" StrokeLineCap="Round"/></Canvas></Viewbox></Button>
      </Grid></Border>
      <Border Grid.Column="1" Background="#251D20" BorderBrush="#463739" BorderThickness="0,0,1,0"><Grid RowDefinitions="76,Auto,*">
        <TextBlock x:Name="LibrarySidebarTitle" Text="CANLI TV" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="24,0"/>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="24,14,18,10"><TextBlock Text="Gruplar" Foreground="#C9B7B3"/><Viewbox Grid.Column="1" Width="14" Height="14" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M4,7 H20 M4,12 H20 M4,17 H20" Stroke="#C9B7B3" StrokeThickness="1.8" StrokeLineCap="Round"/></Canvas></Viewbox></Grid>
        <ListBox Grid.Row="2" x:Name="GroupList" SelectionChanged="GroupList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate x:DataType="local:ChannelGroup"><Grid ColumnDefinitions="48,*,Auto" Margin="18,7"><Border Width="42" Height="42" CornerRadius="14" Background="#342A2D" BorderBrush="#574548" BorderThickness="1"><Grid><Ellipse Width="16" Height="16" Stroke="#C9B7B3" StrokeThickness="1.5"/><Ellipse Width="6" Height="6" Fill="#C9B7B3"/></Grid></Border><StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/><TextBlock Text="{Binding Count, StringFormat={}{0:N0} içerik}" FontSize="10" Foreground="#8E7A78"/></StackPanel><Viewbox Grid.Column="2" Width="14" Height="14" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M9,5 L16,12 L9,19" Stroke="#8E7A78" StrokeThickness="1.9" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
      </Grid></Border>
    </Grid>

    <Grid x:Name="ContentArea" Grid.Column="1" Background="#1D1719" RowDefinitions="76,*" IsVisible="False">
      <Grid x:Name="HeaderPanel" ColumnDefinitions="Auto,*,320" Background="#191316">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
          <Button x:Name="LiveSectionButton" Classes="sectionButton active" Click="LiveSection_Click"><StackPanel Orientation="Horizontal" Spacing="9"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M4,5 H20 A2,2 0 0 1 22,7 V17 A2,2 0 0 1 20,19 H4 A2,2 0 0 1 2,17 V7 A2,2 0 0 1 4,5 M8,1 L12,5 L16,1 L17.5,2.5 L15,5 H20 A4,4 0 0 1 24,9 V17 A4,4 0 0 1 20,21 H4 A4,4 0 0 1 0,17 V9 A4,4 0 0 1 4,5 H9 L6.5,2.5 Z M9,9 V15 L15,12 Z" Fill="{Binding $parent[Button].Foreground}"/></Canvas></Viewbox><TextBlock Text="Canlı TV" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="MovieSectionButton" Classes="sectionButton" Click="MovieSection_Click"><StackPanel Orientation="Horizontal" Spacing="9"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M3,4 H21 V7 H3 Z M3,9 H21 V21 H3 Z M5,2 L8,7 H11 L8,2 Z M12,2 L15,7 H18 L15,2 Z M9,12 L9,18 L15,15 Z" Fill="{Binding $parent[Button].Foreground}"/></Canvas></Viewbox><TextBlock Text="Filmler" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="SeriesSectionButton" Classes="sectionButton" Click="SeriesSection_Click"><StackPanel Orientation="Horizontal" Spacing="9"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M6,3 H22 V17 H6 Z M2,7 H4 V19 H18 V21 H2 Z M11,7 V13 L16,10 Z" Fill="{Binding $parent[Button].Foreground}"/></Canvas></Viewbox><TextBlock Text="Diziler" VerticalAlignment="Center"/></StackPanel></Button>
        </StackPanel>
        <Border Grid.Column="2" Height="42" CornerRadius="21" Background="#211A1D" BorderBrush="#463739" BorderThickness="1" Margin="0,0,20,0" VerticalAlignment="Center"><Grid ColumnDefinitions="Auto,*"><Viewbox Width="17" Height="17" Margin="15,0,0,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M10.5,4 A6.5,6.5 0 1 1 10.48,4 M15.4,15.4 L20.5,20.5" Stroke="#8E7A78" StrokeThickness="1.9" StrokeLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBox Grid.Column="1" x:Name="SearchBox" Watermark="Bu bölümde ara" TextChanged="SearchBox_TextChanged" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="11,0" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,10,0"/></Grid></Border>
      </Grid>
      <Grid x:Name="ContentBody" Grid.Row="1" ColumnDefinitions="430,*">
        <Border x:Name="ChannelPanel" Background="#1D1719" BorderBrush="#463739" BorderThickness="0,0,1,0"><Grid RowDefinitions="56,*">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="18,0"><Button x:Name="SeriesBackButton" Classes="backButton" Click="SeriesBack_Click" IsVisible="False" Margin="0,0,10,0" ToolTip.Tip="Geri"><Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="M14,5 L7,12 L14,19" Stroke="#FFFFFF" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="Ulusal Kanallar" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="BrowserTitle" Text="KANALLAR" FontSize="9" Foreground="#8E7A78"/></StackPanel><TextBlock Grid.Column="2" x:Name="ChannelCount" Text="0 kanal" VerticalAlignment="Center" Foreground="#8E7A78" FontSize="10"/><Button Grid.Column="3" x:Name="ClearHistoryButton" Click="ClearRecentHistory_Click" IsVisible="False" Padding="9,5" Margin="8,0,0,0" FontSize="9"><StackPanel Orientation="Horizontal" Spacing="6"><Path Data="M6,7 H18 M9,7 V5 H15 V7 M8,9 V19 H16 V9 M10.5,11 V17 M13.5,11 V17" Stroke="#EE5A3C" StrokeThickness="1.5" StrokeLineCap="Round" Width="13" Height="13" Stretch="Uniform"/><TextBlock x:Name="ClearHistoryText" Text="Geçmişi Temizle" VerticalAlignment="Center"/></StackPanel></Button></Grid>
          <ListBox Grid.Row="1" x:Name="ChannelList" SelectionChanged="ChannelList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate x:DataType="local:MediaBrowserItem"><Border Background="#2A2124" BorderBrush="#463739" BorderThickness="1" CornerRadius="16" Margin="14,4" Padding="14"><Grid ColumnDefinitions="106,*,Auto" MinHeight="102" ToolTip.Tip="{Binding Name}"><Border Background="#211A1D" CornerRadius="12"><local:ChannelLogo Width="94" Height="82" LogoUrl="{Binding LogoUrl}" Initials="{Binding Initials}"/></Border><StackPanel Grid.Column="1" Margin="18,3,10,0"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="#C9B7B3" FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0"><Border Background="#403233" CornerRadius="100" Padding="8,3"><TextBlock Text="{Binding Badge}" FontSize="9"/></Border><Border Background="#403233" CornerRadius="100" Padding="8,3"><TextBlock Text="EPG" FontSize="9"/></Border></StackPanel></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><Viewbox Width="21" Height="21" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M12,2.5 L14.9,8.4 L21.4,9.3 L16.7,13.9 L17.8,20.4 L12,17.3 L6.2,20.4 L7.3,13.9 L2.6,9.3 L9.1,8.4 Z" Fill="Transparent" Stroke="#EE5A3C" StrokeThickness="1.6" StrokeJoin="Round"/></Canvas></Viewbox><Button Classes="historyAction" IsVisible="{Binding CanRemoveFromHistory}" CommandParameter="{Binding Channel}" Click="RemoveRecentItem_Click"><Path Data="M5,5 L15,15 M15,5 L5,15" Stroke="#FFFFFF" StrokeThickness="1.6" Width="10" Height="10" Stretch="Uniform"/></Button></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
        </Grid></Border>
        <Border x:Name="PlayerPanel" Grid.Column="1" Background="#0B0809" ClipToBounds="True"><Grid x:Name="PlayerSurfaceLayout" ColumnDefinitions="*,0"><Grid x:Name="PlayerLayout" Grid.Column="0" RowDefinitions="*,104">
          <Grid Background="Black"><Border x:Name="PlayerPlaceholder" Background="#0B0809"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15"><Border Width="72" Height="72" CornerRadius="24" Background="#2A2124" BorderBrush="#463739" BorderThickness="1"><Path Data="M7,4 L20,12 L7,20 Z" Fill="#EE5A3C" Width="26" Height="26" Stretch="Uniform" Margin="4,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="İzlemeye hazır" FontSize="22" FontWeight="Bold"/><TextBlock Text="Bir kanal veya içerik seç" Foreground="#8E7A78"/></StackPanel></Border><local:NativeVlcHost x:Name="PlayerView" IsVisible="False"/></Grid>
          <Grid x:Name="PlayerControls" Grid.Row="1" Background="#1D1719" RowDefinitions="Auto,*" Margin="18,9,18,12"><Grid x:Name="TimelinePanel" ColumnDefinitions="*,Auto" IsVisible="False"><Slider x:Name="Timeline" Minimum="0" Maximum="1" Value="0" IsEnabled="False"/><TextBlock Grid.Column="1" x:Name="TimeLabel" Text="CANLI" Foreground="#C9B7B3" FontSize="10" Margin="12,0,0,0"/></Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,6,0,0"><StackPanel VerticalAlignment="Center" Margin="2,0,14,0"><StackPanel Orientation="Horizontal" Spacing="8"><Border Background="#40FF4D5E" CornerRadius="100" Padding="8,3" VerticalAlignment="Center"><TextBlock x:Name="PlaybackKindBadge" Text="HAZIR" Foreground="#FF9BA6" FontSize="8"/></Border><TextBlock x:Name="NowPlaying" Text="İzlemek için bir kanal seçin" FontSize="15" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock x:Name="PlaybackStatus" Text="Hazır" Foreground="#C9B7B3" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
              <Border Grid.Column="1" CornerRadius="30" Background="#2A2124" BorderBrush="#463739" BorderThickness="1" Padding="5" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                <Button x:Name="PreviousChannelButton" Classes="playerAction" Click="PreviousChannel_Click" IsEnabled="False" ToolTip.Tip="Önceki kanal"><Viewbox Width="19" Height="19"><Canvas Width="24" Height="24"><Path Data="M6,5 L6,19 M19,5 L9,12 L19,19 Z" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeLineCap="Round" Fill="Transparent"/></Canvas></Viewbox></Button>
                <Button x:Name="LastChannelButton" Classes="playerAction" Click="LastChannel_Click" IsEnabled="False" ToolTip.Tip="Son kanal"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M4,4 L4,9 L9,9 M5.5,7 A8,8 0 1 1 4.8,15" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeLineCap="Round"/></Canvas></Viewbox></Button>
                <Button x:Name="NextChannelButton" Classes="playerAction" Click="NextChannel_Click" IsEnabled="False" ToolTip.Tip="Sonraki kanal"><Viewbox Width="19" Height="19"><Canvas Width="24" Height="24"><Path Data="M18,5 L18,19 M5,5 L15,12 L5,19 Z" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeLineCap="Round" Fill="Transparent"/></Canvas></Viewbox></Button>
                <Button x:Name="EpgButton" Classes="playerAction" Margin="7,0,0,0" Click="ToggleEpgPanel_Click" IsEnabled="False" ToolTip.Tip="Yayın akışı"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M4,5 L20,5 L20,20 L4,20 Z M8,2 L8,7 M16,2 L16,7 M4,10 L20,10 M8,14 L10,14 M14,14 L16,14 M8,17 L10,17 M14,17 L16,17" Stroke="#FFFFFF" StrokeThickness="1.6" StrokeLineCap="Round"/></Canvas></Viewbox></Button>
                <Button x:Name="FavoriteButton" Classes="playerAction" Click="FavoriteButton_Click" IsEnabled="False" ToolTip.Tip="Favori"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path x:Name="FavoriteOutlineIcon" Data="M12,2.5 L14.9,8.4 L21.4,9.3 L16.7,13.9 L17.8,20.4 L12,17.3 L6.2,20.4 L7.3,13.9 L2.6,9.3 L9.1,8.4 Z" Fill="Transparent" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeJoin="Round"/><Path x:Name="FavoriteFilledIcon" Data="M12,2.5 L14.9,8.4 L21.4,9.3 L16.7,13.9 L17.8,20.4 L12,17.3 L6.2,20.4 L7.3,13.9 L2.6,9.3 L9.1,8.4 Z" Fill="#EE5A3C" IsVisible="False"/></Canvas></Viewbox></Button>
                <Button x:Name="VolumeButton" Classes="playerAction" Click="VolumeButton_Click" ToolTip.Tip="Ses"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M3,9 L7,9 L12,5 L12,17 L7,13 L3,13 Z" Stroke="#FFFFFF" StrokeThickness="1.7" StrokeLineCap="Round" Fill="Transparent"/><Path x:Name="VolumeWaveIcon" Data="M15,8 C17,10 17,12 15,14 M18,5 C22,9 22,13 18,17" Stroke="#FFFFFF" StrokeThickness="1.7" StrokeLineCap="Round"/><Path x:Name="VolumeMutedIcon" Data="M15,9 L20,14 M20,9 L15,14" Stroke="#FF4D5E" StrokeThickness="1.8" StrokeLineCap="Round" IsVisible="False"/></Canvas></Viewbox></Button>
                <Slider x:Name="VolumeSlider" Classes="volume" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeSlider_ValueChanged"/>
                <Border Width="1" Height="22" Background="#463739" Margin="7,0" VerticalAlignment="Center"/>
                <Button x:Name="RewindButton" Classes="playerAction" Click="Rewind_Click" IsVisible="False" IsEnabled="False" ToolTip.Tip="10 saniye geri"><Grid><Viewbox Width="23" Height="23"><Canvas Width="24" Height="24"><Path Data="M5,5 L5,10 L10,10 M6,8 A8,8 0 1 1 5,16" Stroke="#FFFFFF" StrokeThickness="1.6" StrokeLineCap="Round"/></Canvas></Viewbox><TextBlock Text="10" FontSize="7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Button>
                <Button x:Name="ForwardButton" Classes="playerAction" Click="Forward_Click" IsVisible="False" IsEnabled="False" ToolTip.Tip="10 saniye ileri"><Grid><Viewbox Width="23" Height="23"><Canvas Width="24" Height="24"><Path Data="M19,5 L19,10 L14,10 M18,8 A8,8 0 1 0 19,16" Stroke="#FFFFFF" StrokeThickness="1.6" StrokeLineCap="Round"/></Canvas></Viewbox><TextBlock Text="10" FontSize="7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Button>
                <Button x:Name="PlayPauseButton" Classes="playerAction primary" Click="PlayPause_Click" IsEnabled="False" ToolTip.Tip="Oynat / duraklat"><Path x:Name="PlayPauseIcon" Data="M3,2 L7,2 L7,18 L3,18 Z M13,2 L17,2 L17,18 L13,18 Z" Fill="#191316" Width="17" Height="17" Stretch="Uniform"/></Button>
                <Button x:Name="FullscreenButton" Classes="playerAction" Click="Fullscreen_Click" ToolTip.Tip="Tam ekran"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M4,9 L4,4 L9,4 M15,4 L20,4 L20,9 M20,15 L20,20 L15,20 M9,20 L4,20 L4,15" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeLineCap="Round"/></Canvas></Viewbox></Button>
              </StackPanel></Border>
            </Grid>
          </Grid>
        </Grid>
        <Border x:Name="EpgPanel" Grid.Column="1" IsVisible="False" Background="#251D20" BorderBrush="#463739" BorderThickness="1,0,0,0" Padding="18"><Grid RowDefinitions="Auto,Auto,Auto,Auto,*"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="7 GÜNLÜK YAYIN AKIŞI" Foreground="#EE5A3C" FontSize="9"/><TextBlock x:Name="EpgChannelName" Text="Kanal" FontSize="18" FontWeight="Bold"/></StackPanel><Button Grid.Column="1" Classes="backButton" Click="CloseEpgPanel_Click" ToolTip.Tip="Kapat"><Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="#FFFFFF" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button></Grid><Border Grid.Row="1" Height="1" Background="#463739" Margin="0,15,0,10"/><Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto"><Button x:Name="EpgPreviousDayButton" Classes="backButton" Click="EpgPreviousDay_Click" ToolTip.Tip="Önceki gün"><Viewbox Width="13" Height="13"><Canvas Width="24" Height="24"><Path Data="M14,5 L7,12 L14,19" Stroke="#FFFFFF" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button><TextBlock Grid.Column="1" x:Name="EpgDateText" Text="BUGÜN" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Grid.Column="2" x:Name="EpgNextDayButton" Classes="backButton" Click="EpgNextDay_Click" ToolTip.Tip="Sonraki gün"><Viewbox Width="13" Height="13"><Canvas Width="24" Height="24"><Path Data="M10,5 L17,12 L10,19" Stroke="#FFFFFF" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button></Grid><TextBox Grid.Row="3" x:Name="EpgSearchBox" Watermark="Program ara..." TextChanged="EpgSearchBox_TextChanged" Margin="0,8"/><Grid Grid.Row="4"><TextBlock x:Name="EpgEmptyText" Text="Bu kanal için yayın akışı bulunamadı." Foreground="#8E7A78" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/><ListBox x:Name="EpgProgrammeList" IsVisible="False"><ListBox.ItemTemplate><DataTemplate x:DataType="local:EpgProgrammeItem"><Border Background="{Binding Background}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,4"><Grid ColumnDefinitions="56,*"><TextBlock Text="{Binding TimeText}" Foreground="{Binding TimeForeground}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding Category}" Foreground="#FF8A6B" FontSize="9"/><TextBlock Text="{Binding Description}" Foreground="#A08C89" TextWrapping="Wrap" MaxHeight="38"/><TextBlock Text="{Binding StatusText}" Foreground="#EE5A3C" FontSize="9" IsVisible="{Binding IsCurrent}"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Grid></Border>
        </Grid></Border>
      </Grid>
    </Grid>

    <Grid x:Name="SettingsPage" Grid.Column="1" Margin="38,30" IsVisible="False" RowDefinitions="Auto,Auto,Auto,*"><Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18"><StackPanel><TextBlock Text="UYGULAMA" Foreground="#EE5A3C"/><TextBlock Text="Oynatma Listeleri" FontSize="30" FontWeight="Bold"/><TextBlock Text="M3U, dosya veya Xtream hesabı ekleyin." Foreground="#C9B7B3"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"><Button Content="Dosyadan ekle" Click="AddPlaylistFile_Click"/><Button Content="Kapat" Click="HideSettings_Click"/></StackPanel></Grid><Border Grid.Row="1" Background="#251D20" BorderBrush="#463739" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,14"><Grid ColumnDefinitions="190,*,Auto" RowDefinitions="Auto,Auto"><TextBlock Grid.ColumnSpan="3" Text="M3U URL EKLE" Foreground="#EE5A3C"/><TextBox Grid.Row="1" x:Name="PlaylistNameBox" Watermark="Liste adı" Margin="0,0,10,0"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="PlaylistUrlBox" Watermark="https://ornek.com/playlist.m3u" Margin="0,0,10,0"/><Button Grid.Row="1" Grid.Column="2" Click="AddPlaylistUrl_Click"><StackPanel Orientation="Horizontal" Spacing="8"><Viewbox Width="13" Height="13"><Canvas Width="24" Height="24"><Path Data="M12,5 L12,19 M5,12 L19,12" Stroke="#FFFFFF" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox><TextBlock Text="Ekle"/></StackPanel></Button></Grid></Border><Border Grid.Row="2" Background="#251D20" BorderBrush="#463739" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,14"><Grid RowDefinitions="Auto,Auto" ColumnDefinitions="170,*,180,180,Auto"><TextBlock Grid.ColumnSpan="5" Text="XTREAM HESABI EKLE" Foreground="#EE5A3C"/><TextBox Grid.Row="1" x:Name="XtreamNameBox" Watermark="Hesap adı" Margin="0,0,8,0"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="XtreamServerBox" Watermark="http://sunucu:port" Margin="0,0,8,0"/><TextBox Grid.Row="1" Grid.Column="2" x:Name="XtreamUsernameBox" Watermark="Kullanıcı adı" Margin="0,0,8,0"/><TextBox Grid.Row="1" Grid.Column="3" x:Name="XtreamPasswordBox" Watermark="Şifre" PasswordChar="●" Margin="0,0,8,0"/><Button Grid.Row="1" Grid.Column="4" Click="AddXtreamPlaylist_Click"><StackPanel Orientation="Horizontal" Spacing="8"><Viewbox Width="13" Height="13"><Canvas Width="24" Height="24"><Path Data="M12,5 L12,19 M5,12 L19,12" Stroke="#FFFFFF" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox><TextBlock Text="Xtream Ekle"/></StackPanel></Button></Grid></Border><Border Grid.Row="3" Background="#251D20" BorderBrush="#463739" BorderThickness="1" CornerRadius="18" Padding="16"><Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="KAYITLI LİSTELER"/><TextBlock Grid.Column="1" x:Name="PlaylistCountText"/></Grid><ListBox Grid.Row="1" x:Name="PlaylistSettingsList"><ListBox.ItemTemplate><DataTemplate x:DataType="local:PlaylistEntry"><Border Background="#2A2124" BorderBrush="#463739" BorderThickness="1" CornerRadius="16" Padding="16" Margin="4"><Grid ColumnDefinitions="*,Auto,Auto,Auto"><StackPanel><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding DisplayPath}" Foreground="#8E7A78"/></StackPanel><Button Grid.Column="1" Content="Yenile" Click="RefreshSavedPlaylist_Click" CommandParameter="{Binding}"/><Button Grid.Column="2" Content="{Binding ActiveText}" Click="ActivatePlaylist_Click" CommandParameter="{Binding}"/><Button Grid.Column="3" Content="Kaldır" Click="RemovePlaylist_Click" CommandParameter="{Binding}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border></Grid>
    <Grid x:Name="AboutPage" Grid.Column="1" IsVisible="False"><Border MaxWidth="820" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#251D20" BorderBrush="#463739" BorderThickness="1" CornerRadius="20" Padding="38"><Grid RowDefinitions="Auto,Auto,Auto,Auto"><Grid ColumnDefinitions="96,*"><Image Source="avares://BG-IPTV-Player/Assets/app-icon.png" Width="82" Height="82"/><StackPanel Grid.Column="1"><TextBlock Text="BG IPTV Player" FontSize="31"/><TextBlock x:Name="AboutVersionText" Text="Sürüm 1.3.2" Foreground="#EE5A3C"/></StackPanel></Grid><TextBlock Grid.Row="1" Text="M3U ve IPTV listelerini uygulama içinde oynatmak için geliştirilmiş Windows masaüstü uygulaması." TextWrapping="Wrap" Margin="0,25"/><TextBlock Grid.Row="2" Text="Geliştiren: Berk Güçlükol"/><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Web Sitesi" Click="OpenHomepage_Click"/><Button Content="Gizlilik" Click="OpenPrivacy_Click"/><Button Content="GitHub" Click="OpenGithub_Click"/><Button Content="Kapat" Click="HideAbout_Click"/></StackPanel></Grid></Border></Grid>
    <Border x:Name="UpdateBanner" Grid.Column="1" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="38,20" Padding="18,14" Background="#2A2124" BorderBrush="#EE5A3C" BorderThickness="1" CornerRadius="16" MaxWidth="520"><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="14"><StackPanel VerticalAlignment="Center" MaxWidth="250"><TextBlock x:Name="UpdateTitle" Text="Yeni sürüm hazır" FontWeight="SemiBold"/><TextBlock x:Name="UpdateStatusText" Text="İndirilip kurulur, ardından uygulama yeniden başlar." FontSize="11" Foreground="#C9B7B3" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" x:Name="UpdateNowButton" Content="Güncelle" Click="UpdateNow_Click" VerticalAlignment="Center"/><Button Grid.Column="2" Classes="linkButton" Content="Notlar" Click="OpenUpdate_Click" VerticalAlignment="Center"/><Button Grid.Column="3" Classes="backButton" Click="DismissUpdate_Click" VerticalAlignment="Center" ToolTip.Tip="Kapat"><Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="#FFFFFF" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button></Grid></Border>
      <Grid x:Name="LoadingOverlay" Grid.Column="0" Grid.ColumnSpan="2" Background="#191316">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" Width="340">
          <Image Source="avares://BG-IPTV-Player/Assets/app-icon.png" Height="86" HorizontalAlignment="Center"/>
          <StackPanel Spacing="8">
            <TextBlock Text="BG IPTV Player" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="LoadingStatusText" Text="Oynatma listesi hazırlanıyor..." FontSize="12.5" Foreground="#C9B7B3" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <ProgressBar IsIndeterminate="True" Height="4" Width="240" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
  </Grid>
</Window>
