          <StackPanel x:Name="SettingsSectionStats" Spacing="16" IsVisible="False"><StackPanel Spacing="6"><TextBlock Classes="sectionTitle" Text="İstatistikler"/><TextBlock Classes="cardHint" Text="İzleme süreleri yalnızca bu cihazda tutulur."/></StackPanel><Border Classes="card"><Grid ColumnDefinitions="*,*,*"><StackPanel Spacing="6"><TextBlock Classes="eyebrow" Text="TOPLAM İZLEME"/><TextBlock x:Name="StatsTotalText" Text="0 dk" FontSize="22" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock Classes="eyebrow" Text="İZLENEN İÇERİK"/><TextBlock x:Name="StatsItemsText" Text="0" FontSize="22" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="2" Spacing="6"><TextBlock Classes="eyebrow" Text="AÇILIŞ SAYISI"/><TextBlock x:Name="StatsPlaysText" Text="0" FontSize="22" FontWeight="Bold"/></StackPanel></Grid></Border><Border Classes="card"><StackPanel Spacing="14"><TextBlock Classes="cardTitle" Text="Türlere göre"/><StackPanel x:Name="StatsKindList" Spacing="11"/></StackPanel></Border><Border Classes="card"><StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><TextBlock Classes="cardTitle" Text="En çok izlenenler"/><Button Grid.Column="1" Content="İstatistikleri sıfırla" Click="ResetStats_Click" VerticalAlignment="Center"/></Grid><TextBlock x:Name="StatsEmptyText" Classes="cardHint" Text="Henüz izleme kaydı yok."/><StackPanel x:Name="StatsTopList" Spacing="9"/></StackPanel></Border></StackPanel>
          <StackPanel x:Name="SettingsSectionPrivacy" Spacing="16" IsVisible="False"><StackPanel Spacing="6"><TextBlock Classes="sectionTitle" Text="Gizlilik"/><TextBlock Classes="cardHint" Text="Verileriniz cihazınızda kalır"/></StackPanel><Border Classes="card"><Grid ColumnDefinitions="Auto,*"><Border Width="52" Height="52" CornerRadius="15" Background="{DynamicResource AccentTintBrush}" VerticalAlignment="Top"><Viewbox Width="25" Height="25"><Canvas Width="24" Height="24"><Path Data="M12,3 L20,6.4 L20,12 C20,16.4 16.6,19.8 12,21.4 C7.4,19.8 4,16.4 4,12 L4,6.4 Z M9,12.2 L11.3,14.5 L15.4,10" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox></Border><StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="8" VerticalAlignment="Center"><TextBlock Classes="cardTitle" Text="Verileriniz cihazınızda kalır"/><TextBlock Classes="cardHint" Text="Uygulama hesap açmanızı istemez, kullanım verisi toplamaz ve içeriklerinizi hiçbir sunucuya göndermez."/></StackPanel></Grid></Border><Border Classes="card"><StackPanel Spacing="14"><TextBlock Classes="cardTitle" Text="Cihazda saklananlar"/><StackPanel Spacing="9"><Grid ColumnDefinitions="Auto,*"><Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="1,0,0,0"/><TextBlock Grid.Column="1" Classes="cardHint" Text="Oynatma listesi adresleri ve Xtream hesap bilgileri" Margin="13,0,0,0"/></Grid><Grid ColumnDefinitions="Auto,*"><Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="1,0,0,0"/><TextBlock Grid.Column="1" Classes="cardHint" Text="İzleme geçmişi, favoriler ve kaldığınız konum" Margin="13,0,0,0"/></Grid><Grid ColumnDefinitions="Auto,*"><Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="1,0,0,0"/><TextBlock Grid.Column="1" Classes="cardHint" Text="Liste ve yayın akışı önbelleği" Margin="13,0,0,0"/></Grid></StackPanel><Border Height="1" Background="{DynamicResource BorderBg}"/><StackPanel Spacing="8"><TextBlock Classes="eyebrow" Text="VERİ KLASÖRÜ"/><TextBlock x:Name="SettingsDataPathText" Classes="cardHint" Foreground="{DynamicResource TextFaintBg}" FontSize="11.5" Text=""/></StackPanel><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Klasörü aç" Click="OpenDataFolder_Click"/><Button Content="İzleme geçmişini temizle" Click="ClearWatchData_Click"/><Button Content="Önbelleği temizle" Click="ClearCacheData_Click"/></StackPanel><TextBlock x:Name="SettingsPrivacyStatus" Classes="cardHint" Foreground="{DynamicResource AccentSoftBrush}" Text="" IsVisible="False"/></StackPanel></Border><Border Classes="card"><StackPanel Spacing="14"><TextBlock Classes="cardTitle" Text="Ebeveyn kilidi"/><TextBlock Classes="cardHint" Text="Bir gruba sağ tıklayıp kilitleyebilirsin. Kilitli gruplar PIN girilene kadar listede görünmez."/><Grid ColumnDefinitions="160,Auto,*" ColumnSpacing="10"><TextBox x:Name="ParentalPinBox" Watermark="4-8 haneli PIN" PasswordChar="●" MaxLength="8"/><Button Grid.Column="1" x:Name="ParentalPinButton" Content="PIN belirle" Click="SetParentalPin_Click"/><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"><Button x:Name="ParentalUnlockButton" Content="Kilidi aç" Click="UnlockParental_Click" IsVisible="False"/><Button x:Name="ParentalRemoveButton" Content="PIN'i kaldır" Click="RemoveParentalPin_Click" IsVisible="False"/></StackPanel></Grid><TextBlock x:Name="ParentalStatusText" Classes="cardHint" Foreground="{DynamicResource AccentSoftBrush}" IsVisible="False"/><TextBlock x:Name="NoLockedGroupsText" Classes="cardHint" Text="Kilitli grup yok."/><ItemsControl x:Name="LockedGroupsList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderBg}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Content="Kilidi kaldır" Click="UnlockGroup_Click" CommandParameter="{Binding}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Classes="card"><StackPanel Spacing="12"><TextBlock Classes="cardTitle" Text="Ağ bağlantıları"/><TextBlock Classes="cardHint" Text="Yalnızca sizin eklediğiniz liste sunucularına, yayın kaynaklarına ve sürüm denetimi için GitHub sayfasına bağlanılır."/><Button Classes="linkButton" Content="Gizlilik metnini aç" Click="OpenPrivacy_Click" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel>
          <StackPanel x:Name="SettingsSectionAbout" Spacing="16" IsVisible="False"><StackPanel Spacing="6"><TextBlock Classes="sectionTitle" Text="Hakkında"/><TextBlock Classes="cardHint" Text="Geliştiren: Berk Güçlükol"/></StackPanel><Border Classes="card" Padding="26"><StackPanel Spacing="20"><Grid ColumnDefinitions="Auto,*"><Image Source="avares://BG-IPTV-Player/Assets/app-icon.png" Width="76" Height="76" VerticalAlignment="Top"/><StackPanel Grid.Column="1" Margin="20,2,0,0" Spacing="7"><TextBlock Text="BG IPTV Player" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="AboutVersionText" Text="Sürüm 1.0.0" FontSize="12.5" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Classes="cardHint" Text="M3U ve IPTV listelerini uygulama içinde oynatmak için geliştirilmiş Windows masaüstü uygulaması." Margin="0,4,0,0" MaxWidth="520" HorizontalAlignment="Left"/></StackPanel></Grid><Border Height="1" Background="{DynamicResource BorderBg}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="18"><StackPanel Spacing="7"><TextBlock Classes="eyebrow" Text="GELİŞTİREN"/><TextBlock Text="Berk Güçlükol" FontSize="13"/></StackPanel><StackPanel Grid.Column="1" Spacing="7"><TextBlock Classes="eyebrow" Text="KULLANILAN TEKNOLOJİLER"/><TextBlock Text="Avalonia UI · LibVLC · .NET 8" FontSize="13"/></StackPanel></Grid><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Web Sitesi" Click="OpenHomepage_Click"/><Button Content="GitHub" Click="OpenGithub_Click"/><Button Content="Gizlilik" Click="OpenPrivacy_Click"/></StackPanel><Border Height="1" Background="{DynamicResource BorderBg}"/><StackPanel Spacing="12"><TextBlock Classes="cardTitle" Text="Sorun bildirimi"/><TextBlock Classes="cardHint" Text="Bir hata ile karşılaşırsan günlük dosyasını GitHub üzerinden paylaşabilirsin."/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Günlük dosyasını aç" Click="OpenLogFile_Click"/><Button Content="Sorun bildir" Click="ReportIssue_Click"/></StackPanel></StackPanel></StackPanel></Border></StackPanel>
