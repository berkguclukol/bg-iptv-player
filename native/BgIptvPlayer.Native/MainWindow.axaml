<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BgIptvPlayer.Native"
        x:Class="BgIptvPlayer.Native.MainWindow" Title="BG IPTV Player" Icon="avares://BG-IPTV-Player/Assets/app-icon.png"
        Width="1500" Height="900" MinWidth="1120" MinHeight="700" Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextBg}"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter" KeyDown="Window_KeyDown" PointerMoved="Window_PointerMoved">
  <Window.Resources>
    <SolidColorBrush x:Key="WindowBg" Color="#0F1114"/>
    <SolidColorBrush x:Key="PanelBg" Color="#14171B"/>
    <SolidColorBrush x:Key="CardBg" Color="#171A1F"/>
    <SolidColorBrush x:Key="SurfaceBg" Color="#1C2026"/>
    <SolidColorBrush x:Key="Surface2Bg" Color="#242931"/>
    <SolidColorBrush x:Key="Surface3Bg" Color="#2D333C"/>
    <SolidColorBrush x:Key="HoverBg" Color="#191D22"/>
    <SolidColorBrush x:Key="BorderBg" Color="#262B33"/>
    <SolidColorBrush x:Key="Border2Bg" Color="#343B45"/>
    <SolidColorBrush x:Key="DividerBg" Color="#1F242B"/>
    <SolidColorBrush x:Key="TextBg" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="TextMutedBg" Color="#A3ABB8"/>
    <SolidColorBrush x:Key="TextFaintBg" Color="#6B7482"/>
    <SolidColorBrush x:Key="TextFaint2Bg" Color="#8791A0"/>
    <SolidColorBrush x:Key="TrackBg" Color="#525B69"/>
    <SolidColorBrush x:Key="TrackHoverBg" Color="#59636F"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#F2622E"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FF8A5C"/>
    <SolidColorBrush x:Key="AccentTintBrush" Color="#26F2622E"/>
    <SolidColorBrush x:Key="AccentTintStrongBrush" Color="#33F2622E"/>
    <SolidColorBrush x:Key="AccentGhostBrush" Color="#21F2622E"/>
    <SolidColorBrush x:Key="AccentStripeBrush" Color="#0EF2622E"/>
    <SolidColorBrush x:Key="HomeNumeralBrush" Color="#0BF2F4F7"/>
    <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
    <SolidColorBrush x:Key="SliderTrackFill" Color="#525B69"/>
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#59636F"/>
    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#59636F"/>
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#F2622E"/>
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FF8A5C"/>
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FF8A5C"/>
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFFFFF"/>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button"><Setter Property="Background" Value="{DynamicResource SurfaceBg}"/><Setter Property="Foreground" Value="{DynamicResource TextBg}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBg}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="16,11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/></Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="{DynamicResource Surface2Bg}"/><Setter Property="BorderBrush" Value="{DynamicResource Border2Bg}"/></Style>
    <Style Selector="Button.navIcon"><Setter Property="Width" Value="50"/><Setter Property="Height" Value="50"/><Setter Property="CornerRadius" Value="25"/><Setter Property="Padding" Value="14"/><Setter Property="Background" Value="{DynamicResource SurfaceBg}"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.navIcon:pointerover"><Setter Property="Background" Value="{DynamicResource Surface2Bg}"/></Style>
    <Style Selector="Button.navIcon.active"><Setter Property="Background" Value="{DynamicResource Surface3Bg}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.sectionButton"><Setter Property="Height" Value="46"/><Setter Property="Width" Value="140"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextMutedBg}"/><Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.sectionButton:pointerover"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource Border2Bg}"/><Setter Property="Foreground" Value="{DynamicResource TextBg}"/></Style>
    <Style Selector="Button.sectionButton.active"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBg}"/></Style>
    <Style Selector="Button.playerAction"><Setter Property="Margin" Value="1.5"/><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.playerAction:pointerover"><Setter Property="Background" Value="{DynamicResource Surface3Bg}"/></Style>
    <Style Selector="Button.playerAction.primary"><Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/><Setter Property="CornerRadius" Value="24"/><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.playerAction.primary:pointerover"><Setter Property="Background" Value="#F5764A"/></Style>
    <Style Selector="Button.backButton"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Background" Value="{DynamicResource Surface2Bg}"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.historyAction"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Background" Value="{DynamicResource Surface2Bg}"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.libCard"><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="{DynamicResource PanelBg}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBg}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="ClipToBounds" Value="True"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/></Style>
    <Style Selector="TextBlock.display"><Setter Property="FontFamily" Value="avares://BG-IPTV-Player/Assets#Bebas Neue"/><Setter Property="LetterSpacing" Value="0.6"/></Style>
    <Style Selector="Button.libCard:pointerover"><Setter Property="Background" Value="{DynamicResource Surface2Bg}"/><Setter Property="BorderBrush" Value="{DynamicResource Border2Bg}"/></Style>
    <Style Selector="Button.linkButton"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="{DynamicResource TextMutedBg}"/><Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.linkButton:pointerover"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="TextBox"><Setter Property="Background" Value="{DynamicResource PanelBg}"/><Setter Property="Foreground" Value="{DynamicResource TextBg}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBg}"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="15,11"/></Style>
    <Style Selector="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="CornerRadius" Value="0"/></Style>
    <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource Surface2Bg}"/></Style>
    <Style Selector="ListBoxItem:selected /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="{DynamicResource Surface2Bg}"/></Style>
    <Style Selector="ListBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource HoverBg}"/></Style>
    <Style Selector="Slider"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="Slider.volume"><Setter Property="Width" Value="84"/><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="0"/><Setter Property="Margin" Value="4,-12,2,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style Selector="Slider.volume /template/ Thumb"><Setter Property="Width" Value="13"/><Setter Property="Height" Value="13"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Background" Value="{DynamicResource TextBg}"/><Setter Property="BorderBrush" Value="{DynamicResource TextBg}"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style Selector="Slider.volume /template/ RepeatButton"><Setter Property="MinHeight" Value="0"/></Style>
    <Style Selector="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="{DynamicResource Surface3Bg}"/><Setter Property="CornerRadius" Value="2"/></Style>
    <Style Selector="Button.settingsTab"><Setter Property="Height" Value="46"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="13,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource TextMutedBg}"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="Button.settingsTab:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceBg}"/><Setter Property="Foreground" Value="{DynamicResource TextBg}"/></Style>
    <Style Selector="Button.settingsTab.active"><Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentSoftBrush}"/></Style>
    <Style Selector="Button.optionCard"><Setter Property="Height" Value="74"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="16,0"/><Setter Property="Background" Value="{DynamicResource SurfaceBg}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBg}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style Selector="Button.optionCard:pointerover"><Setter Property="Background" Value="{DynamicResource Surface2Bg}"/><Setter Property="BorderBrush" Value="{DynamicResource Border2Bg}"/></Style>
    <Style Selector="Button.optionCard.active"><Setter Property="Background" Value="#1FF2622E"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource CardBg}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBg}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="24"/></Style>
    <Style Selector="TextBlock.cardTitle"><Setter Property="FontSize" Value="14.5"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.cardHint"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource TextMutedBg}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="19"/></Style>
    <Style Selector="TextBlock.sectionTitle"><Setter Property="FontFamily" Value="avares://BG-IPTV-Player/Assets#Bebas Neue"/><Setter Property="FontSize" Value="38"/><Setter Property="LineHeight" Value="38"/><Setter Property="LetterSpacing" Value="0.6"/></Style>
    <Style Selector="TextBlock.eyebrow"><Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="LetterSpacing" Value="2.2"/><Setter Property="Foreground" Value="{DynamicResource TextFaintBg}"/></Style>
    <Style Selector="Border.channelCard"><Setter Property="Background" Value="{DynamicResource CardBg}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBg}"/></Style>
    <Style Selector="ListBox.cards ListBoxItem:pointerover"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="ListBox.cards ListBoxItem:selected"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="ListBox.cards ListBoxItem:selected /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="ListBox.cards ListBoxItem:pointerover Border.channelCard"><Setter Property="Background" Value="{DynamicResource Surface2Bg}"/><Setter Property="BorderBrush" Value="{DynamicResource Border2Bg}"/></Style>
    <Style Selector="ListBox.cards ListBoxItem:selected Border.channelCard"><Setter Property="Background" Value="{DynamicResource Surface3Bg}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBg}"/></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Surface2Bg}"/></Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Surface3Bg}"/></Style>
    <Style Selector="ListBox.cards ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="ListBox.cards ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="ListBox.cards ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource PanelBg}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBg}"/></Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource PanelBg}"/><Setter Property="BorderBrush" Value="{DynamicResource Border2Bg}"/></Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource PanelBg}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="TextBox:focus-within /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource PanelBg}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="TextBox.search /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style Selector="TextBox.search:focus-within /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style Selector="Button.homeAction"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="16,0"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.homeAction:pointerover"><Setter Property="Background" Value="{DynamicResource Surface2Bg}"/><Setter Property="Foreground" Value="{DynamicResource AccentSoftBrush}"/></Style>
    <Style Selector="Button.chip"><Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="52"/><Setter Property="Padding" Value="12,0"/><Setter Property="Margin" Value="0,0,7,7"/><Setter Property="CornerRadius" Value="3"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="{DynamicResource SurfaceBg}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBg}"/></Style>
    <Style Selector="Button.chip.active"><Setter Property="Background" Value="{DynamicResource AccentTintStrongBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentSoftBrush}"/></Style>
    <Style Selector="Button.swatch"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="23"/><Setter Property="Background" Value="{DynamicResource SurfaceBg}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBg}"/><Setter Property="BorderThickness" Value="2"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.swatch.active"><Setter Property="BorderBrush" Value="{DynamicResource TextBg}"/></Style>
    <Style Selector="Button.trackOption"><Setter Property="FontSize" Value="12.5"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Background" Value="{DynamicResource SurfaceBg}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBg}"/></Style>
    <Style Selector="Button.trackOption.active"><Setter Property="Background" Value="{DynamicResource AccentTintStrongBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentSoftBrush}"/></Style>
    <Style Selector="Button.backButton.active"><Setter Property="Background" Value="{DynamicResource AccentTintStrongBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="ListBoxItem:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
    <Style Selector="Button:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
  </Window.Styles>

  <Grid x:Name="RootGrid" ColumnDefinitions="0,*">
    <Grid x:Name="HomePage" Grid.Column="1" Background="{DynamicResource WindowBg}" ColumnDefinitions="92,*" IsVisible="True">
      <Image Grid.ColumnSpan="2" x:Name="HomeBackdrop" Source="avares://BG-IPTV-Player/Assets/cinema-background.png" Stretch="UniformToFill" Opacity="0.055"/>
      <Ellipse Grid.ColumnSpan="2" Width="1100" Height="720" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-220,0" IsHitTestVisible="False"><Ellipse.Fill><RadialGradientBrush RadiusX="60%" RadiusY="60%"><GradientStop Color="#18F2622E" Offset="0"/><GradientStop Color="#00F2622E" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
      <Ellipse Grid.ColumnSpan="2" Width="900" Height="640" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-200,0,0,-200" IsHitTestVisible="False"><Ellipse.Fill><RadialGradientBrush RadiusX="60%" RadiusY="60%"><GradientStop Color="#12785AD8" Offset="0"/><GradientStop Color="#00785AD8" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
      <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBg}" BorderThickness="0,0,1,0"><Grid RowDefinitions="Auto,*,Auto" Margin="0,26"><Image Source="avares://BG-IPTV-Player/Assets/app-icon.png" Height="38" HorizontalAlignment="Center"/><LayoutTransformControl Grid.Row="2" HorizontalAlignment="Center"><LayoutTransformControl.LayoutTransform><RotateTransform Angle="-90"/></LayoutTransformControl.LayoutTransform><TextBlock Text="KİTAPLIK" FontSize="10" LetterSpacing="3.4" Foreground="{DynamicResource TextFaintBg}"/></LayoutTransformControl></Grid></Border>
      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="40,34,46,26">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24"><StackPanel VerticalAlignment="Bottom"><TextBlock Text="KİTAPLIĞIN" FontSize="10.5" FontWeight="Bold" LetterSpacing="2.6" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="HomeGreetingText" Classes="display" Text="İYİ AKŞAMLAR" FontSize="54" LineHeight="54" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="22" VerticalAlignment="Bottom"><Border Width="280" Height="40" CornerRadius="10" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBg}" BorderThickness="1" VerticalAlignment="Center"><Grid ColumnDefinitions="Auto,*"><Viewbox Width="15" Height="15" Margin="14,0,0,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M11,4 A7,7 0 1 0 11,18 A7,7 0 1 0 11,4 M16,16 L21,21" Stroke="{DynamicResource TextFaintBg}" StrokeThickness="1.9" StrokeLineCap="Round"/></Canvas></Viewbox><TextBox Grid.Column="1" x:Name="HomeSearchBox" Classes="search" Watermark="Tüm içerikte ara" KeyDown="HomeSearchBox_KeyDown" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="10,0" FontSize="12.5" VerticalContentAlignment="Center" Margin="0,0,8,0"/></Grid></Border><StackPanel VerticalAlignment="Center"><TextBlock x:Name="HomeTimeText" Classes="display" Text="00:00" FontSize="30" LineHeight="30" HorizontalAlignment="Right"/><TextBlock x:Name="HomeDateText" Text="" FontSize="10.5" LetterSpacing="0.8" Foreground="{DynamicResource TextFaintBg}" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel></StackPanel></Grid>
        <Grid Grid.Row="1" ColumnDefinitions="1.55*,1*" ColumnSpacing="22" MaxHeight="520">
          <Button Classes="libCard" Click="HomeLive_Click"><Border CornerRadius="4" ClipToBounds="True"><Grid><Path Data="M0,0 L-460,460 M26,0 L-434,460 M52,0 L-408,460 M78,0 L-382,460 M104,0 L-356,460 M130,0 L-330,460 M156,0 L-304,460 M182,0 L-278,460 M208,0 L-252,460 M234,0 L-226,460 M260,0 L-200,460 M286,0 L-174,460 M312,0 L-148,460 M338,0 L-122,460 M364,0 L-96,460 M390,0 L-70,460 M416,0 L-44,460 M442,0 L-18,460 M468,0 L8,460 M494,0 L34,460 M520,0 L60,460 M546,0 L86,460 M572,0 L112,460 M598,0 L138,460 M624,0 L164,460 M650,0 L190,460 M676,0 L216,460 M702,0 L242,460 M728,0 L268,460 M754,0 L294,460 M780,0 L320,460 M806,0 L346,460 M832,0 L372,460 M858,0 L398,460 M884,0 L424,460 M910,0 L450,460 M936,0 L476,460 M962,0 L502,460 M988,0 L528,460 M1014,0 L554,460 M1040,0 L580,460 M1066,0 L606,460 M1092,0 L632,460 M1118,0 L658,460 M1144,0 L684,460 M1170,0 L710,460 M1196,0 L736,460 M1222,0 L762,460 M1248,0 L788,460 M1274,0 L814,460 M1300,0 L840,460 M1326,0 L866,460 M1352,0 L892,460 M1378,0 L918,460" Stroke="{DynamicResource AccentStripeBrush}" StrokeThickness="2"/><TextBlock Classes="display" Text="01" FontSize="250" LineHeight="196" Foreground="{DynamicResource AccentGhostBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-40,-22,0"/><StackPanel VerticalAlignment="Bottom" Margin="34"><StackPanel Orientation="Horizontal" Spacing="12"><Viewbox Width="26" Height="26" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M4,6 L20,6 L20,18 L4,18 Z M8,22 L16,22 M12,18 L12,22 M8,2 L12,6 L16,2" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Text="CANLI YAYIN" FontSize="10.5" FontWeight="Bold" LetterSpacing="2.4" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" TextAlignment="Left"/></StackPanel><TextBlock Classes="display" Text="CANLI TV" FontSize="92" LineHeight="84" Margin="0,14,0,0" HorizontalAlignment="Left" TextAlignment="Left"/><StackPanel Orientation="Horizontal" Spacing="14" Margin="0,14,0,0"><TextBlock x:Name="HomeLiveCount" Text="0" FontSize="30" FontWeight="Bold" VerticalAlignment="Bottom" TextAlignment="Left"/><TextBlock x:Name="HomeLiveSubtitle" Text="" FontSize="13" Foreground="{DynamicResource TextMutedBg}" VerticalAlignment="Bottom" Margin="0,0,0,5" TextAlignment="Left"/></StackPanel><WrapPanel x:Name="HomeLiveChips" Margin="0,20,0,0"/></StackPanel></Grid></Border></Button>
          <Grid Grid.Column="1" RowDefinitions="*,22,*">
          <Button Grid.Row="0" Classes="libCard" Click="HomeMovie_Click"><Border CornerRadius="4" ClipToBounds="True"><Grid Margin="26"><TextBlock Classes="display" Text="02" FontSize="150" LineHeight="118" Foreground="{DynamicResource HomeNumeralBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-34,-14,0"/><StackPanel VerticalAlignment="Top" Orientation="Horizontal" Spacing="11"><Viewbox Width="22" Height="22" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M3,8 L21,8 L21,20 L3,20 Z M3,8 L5,3 L21,3 L19,8 M8,3 L6,8 M14,3 L12,8" Stroke="{DynamicResource TextBg}" StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Classes="display" Text="FİLMLER" FontSize="36" LineHeight="36" VerticalAlignment="Center" TextAlignment="Left"/></StackPanel><StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="12"><TextBlock x:Name="HomeMovieCount" Text="0" FontSize="26" FontWeight="Bold" VerticalAlignment="Bottom" TextAlignment="Left"/><TextBlock x:Name="HomeMovieSubtitle" Text="" FontSize="12" Foreground="{DynamicResource TextMutedBg}" VerticalAlignment="Bottom" Margin="0,0,0,4" TextAlignment="Left"/></StackPanel></Grid></Border></Button>
          <Button Grid.Row="2" Classes="libCard" Click="HomeSeries_Click"><Border CornerRadius="4" ClipToBounds="True"><Grid Margin="26"><TextBlock Classes="display" Text="03" FontSize="150" LineHeight="118" Foreground="{DynamicResource HomeNumeralBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-34,-14,0"/><StackPanel VerticalAlignment="Top" Orientation="Horizontal" Spacing="11"><Viewbox Width="22" Height="22" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M7,3 L21,3 L21,17 L7,17 Z M3,7 L3,21 L17,21" Stroke="{DynamicResource TextBg}" StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Classes="display" Text="DİZİLER" FontSize="36" LineHeight="36" VerticalAlignment="Center" TextAlignment="Left"/></StackPanel><StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="12"><TextBlock x:Name="HomeSeriesCount" Text="0" FontSize="26" FontWeight="Bold" VerticalAlignment="Bottom" TextAlignment="Left"/><TextBlock x:Name="HomeSeriesSubtitle" Text="" FontSize="12" Foreground="{DynamicResource TextMutedBg}" VerticalAlignment="Bottom" Margin="0,0,0,4" TextAlignment="Left"/></StackPanel></Grid></Border></Button>
          </Grid>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,26,0,0"><Border Height="1" Background="{DynamicResource BorderBg}" VerticalAlignment="Top" Grid.ColumnSpan="2"/><TextBlock x:Name="HomeVersionText" Text="BG IPTV Player" FontSize="11" Foreground="{DynamicResource TextFaintBg}" VerticalAlignment="Center" Margin="0,20,0,0"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" Margin="0,20,0,0"><Button x:Name="HomeRefreshAction" Classes="homeAction" Click="RefreshPlaylist_Click"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M17.65,6.35 A8,8 0 1 0 19.73,14 H17.65 A6,6 0 1 1 16.23,8.17 L13,11.4 H21 V3.4 Z" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Text="YENİLE" FontSize="12.5" FontWeight="SemiBold" LetterSpacing="0.6" VerticalAlignment="Center"/></StackPanel></Button><Border Width="1" Height="18" Background="{DynamicResource BorderBg}" Margin="6,0" VerticalAlignment="Center"/><Button x:Name="HomeAboutAction" Classes="homeAction" Click="ShowAboutFromHome_Click"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M12,10 L12,17 M12,7 L12.01,7" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Text="HAKKINDA" FontSize="12.5" FontWeight="SemiBold" LetterSpacing="0.6" VerticalAlignment="Center"/></StackPanel></Button><Border Width="1" Height="18" Background="{DynamicResource BorderBg}" Margin="6,0" VerticalAlignment="Center"/><Button x:Name="HomeSettingsAction" Classes="homeAction" Click="ShowSettingsFromHome_Click"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M19.14,12.94 C19.18,12.63 19.2,12.32 19.2,12 C19.2,11.68 19.18,11.37 19.13,11.06 L21.23,9.42 L19.23,5.96 L16.76,6.96 C16.26,6.57 15.72,6.25 15.12,6.01 L14.74,3.38 H10.74 L10.36,6.01 C9.76,6.25 9.21,6.58 8.72,6.96 L6.25,5.96 L4.25,9.42 L6.35,11.06 C6.3,11.37 6.28,11.69 6.28,12 C6.28,12.32 6.3,12.63 6.35,12.94 L4.25,14.58 L6.25,18.04 L8.72,17.04 C9.21,17.43 9.76,17.75 10.36,17.99 L10.74,20.62 H14.74 L15.12,17.99 C15.72,17.75 16.27,17.42 16.76,17.04 L19.23,18.04 L21.23,14.58 Z M12.74,15.5 A3.5,3.5 0 1 1 12.74,8.5 A3.5,3.5 0 1 1 12.74,15.5" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Text="AYARLAR" FontSize="12.5" FontWeight="SemiBold" LetterSpacing="0.6" VerticalAlignment="Center"/></StackPanel></Button></StackPanel></Grid>
      </Grid>
    </Grid>

    <Grid x:Name="Sidebar" Grid.Column="0" ColumnDefinitions="92,*" IsVisible="False">
      <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBg}" BorderThickness="0,0,1,0"><Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" Margin="0,18">
        <Image Source="avares://BG-IPTV-Player/Assets/app-icon.png" Height="36" HorizontalAlignment="Center"/>
        <Button Grid.Row="1" Classes="navIcon" Click="BackHome_Click" Margin="0,24,0,12" HorizontalAlignment="Center" ToolTip.Tip="Ana ekran"><Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Data="M15.4,4 L7.4,12 L15.4,20 L17.5,17.9 L11.6,12 L17.5,6.1 Z" Fill="{DynamicResource TextBg}"/></Canvas></Viewbox></Button>
        <Button Grid.Row="2" Classes="navIcon active" Click="LiveSection_Click" Margin="0,6" HorizontalAlignment="Center" ToolTip.Tip="Canlı TV"><Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Data="M4,5 H20 A2,2 0 0 1 22,7 V17 A2,2 0 0 1 20,19 H4 A2,2 0 0 1 2,17 V7 A2,2 0 0 1 4,5 M8,1 L12,5 L16,1 L17.5,2.5 L15,5 H9 L6.5,2.5 Z M9,9 V15 L15,12 Z" Fill="{DynamicResource AccentBrush}"/></Canvas></Viewbox></Button>
        <Button Grid.Row="3" Classes="navIcon" Click="RefreshPlaylist_Click" Margin="0,6" HorizontalAlignment="Center" ToolTip.Tip="Listeyi yenile"><Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Data="M17.65,6.35 A8,8 0 1 0 19.73,14 H17.65 A6,6 0 1 1 16.23,8.17 L13,11.4 H21 V3.4 Z" Fill="{DynamicResource TextBg}"/></Canvas></Viewbox></Button>
        <Button Grid.Row="5" Classes="navIcon" Click="ShowSettings_Click" Margin="0,6" HorizontalAlignment="Center" ToolTip.Tip="Ayarlar"><Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path Data="M19.14,12.94 C19.18,12.63 19.2,12.32 19.2,12 C19.2,11.68 19.18,11.37 19.13,11.06 L21.23,9.42 L19.23,5.96 L16.76,6.96 C16.26,6.57 15.72,6.25 15.12,6.01 L14.74,3.38 H10.74 L10.36,6.01 C9.76,6.25 9.21,6.58 8.72,6.96 L6.25,5.96 L4.25,9.42 L6.35,11.06 C6.3,11.37 6.28,11.69 6.28,12 C6.28,12.32 6.3,12.63 6.35,12.94 L4.25,14.58 L6.25,18.04 L8.72,17.04 C9.21,17.43 9.76,17.75 10.36,17.99 L10.74,20.62 H14.74 L15.12,17.99 C15.72,17.75 16.27,17.42 16.76,17.04 L19.23,18.04 L21.23,14.58 Z M12.74,15.5 A3.5,3.5 0 1 1 12.74,8.5 A3.5,3.5 0 1 1 12.74,15.5" Fill="{DynamicResource TextBg}"/></Canvas></Viewbox></Button>
        <Button Grid.Row="6" Classes="navIcon" Click="ShowAbout_Click" Margin="0,6" HorizontalAlignment="Center" ToolTip.Tip="Hakkında"><Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path Data="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M12,10 L12,17 M12,7 L12.01,7" Stroke="{DynamicResource TextBg}" StrokeThickness="1.9" StrokeLineCap="Round"/></Canvas></Viewbox></Button>
      </Grid></Border>
      <Border Grid.Column="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBg}" BorderThickness="0,0,1,0"><Grid RowDefinitions="76,Auto,*">
        <TextBlock x:Name="LibrarySidebarTitle" Classes="display" Text="CANLI TV" FontSize="34" LineHeight="34" VerticalAlignment="Center" Margin="24,0"/>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="24,14,18,10"><TextBlock Text="GRUPLAR" FontSize="10.5" FontWeight="Bold" LetterSpacing="2.2" Foreground="{DynamicResource TextFaintBg}"/><Viewbox Grid.Column="1" Width="14" Height="14" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M4,7 H20 M4,12 H20 M4,17 H20" Stroke="{DynamicResource TextMutedBg}" StrokeThickness="1.8" StrokeLineCap="Round"/></Canvas></Viewbox></Grid>
        <ListBox Grid.Row="2" x:Name="GroupList" SelectionChanged="GroupList_SelectionChanged" KeyDown="GroupList_KeyDown"><ListBox.ItemTemplate><DataTemplate x:DataType="local:ChannelGroup"><Grid ColumnDefinitions="26,*,Auto" Height="44" Margin="20,0"><Grid.ContextMenu><ContextMenu><MenuItem Header="Grubu gizle" Click="HideGroup_Click"/><MenuItem Header="Grubu kilitle" Click="LockGroup_Click"/></ContextMenu></Grid.ContextMenu><Border Width="26" Height="26" CornerRadius="9" Background="{DynamicResource Surface2Bg}"><TextBlock Text="◦" Foreground="{DynamicResource TextMutedBg}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Margin="12,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/><TextBlock Grid.Column="2" Text="{Binding Count, StringFormat={}{0:N0}}" FontSize="11" Foreground="{DynamicResource TextFaintBg}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
      </Grid></Border>
    </Grid>

    <Grid x:Name="ContentArea" Grid.Column="1" Background="{DynamicResource PanelBg}" RowDefinitions="76,*" IsVisible="False">
      <Grid x:Name="HeaderPanel" ColumnDefinitions="Auto,*,320" Background="{DynamicResource WindowBg}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
          <Button x:Name="LiveSectionButton" Classes="sectionButton active" Click="LiveSection_Click"><StackPanel Orientation="Horizontal" Spacing="9"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M4,5 H20 A2,2 0 0 1 22,7 V17 A2,2 0 0 1 20,19 H4 A2,2 0 0 1 2,17 V7 A2,2 0 0 1 4,5 M8,1 L12,5 L16,1 L17.5,2.5 L15,5 H20 A4,4 0 0 1 24,9 V17 A4,4 0 0 1 20,21 H4 A4,4 0 0 1 0,17 V9 A4,4 0 0 1 4,5 H9 L6.5,2.5 Z M9,9 V15 L15,12 Z" Fill="{Binding $parent[Button].Foreground}"/></Canvas></Viewbox><TextBlock Text="CANLI TV" LetterSpacing="1.2" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="MovieSectionButton" Classes="sectionButton" Click="MovieSection_Click"><StackPanel Orientation="Horizontal" Spacing="9"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M3,4 H21 V7 H3 Z M3,9 H21 V21 H3 Z M5,2 L8,7 H11 L8,2 Z M12,2 L15,7 H18 L15,2 Z M9,12 L9,18 L15,15 Z" Fill="{Binding $parent[Button].Foreground}"/></Canvas></Viewbox><TextBlock Text="FİLMLER" LetterSpacing="1.2" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="SeriesSectionButton" Classes="sectionButton" Click="SeriesSection_Click"><StackPanel Orientation="Horizontal" Spacing="9"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M6,3 H22 V17 H6 Z M2,7 H4 V19 H18 V21 H2 Z M11,7 V13 L16,10 Z" Fill="{Binding $parent[Button].Foreground}"/></Canvas></Viewbox><TextBlock Text="DİZİLER" LetterSpacing="1.2" VerticalAlignment="Center"/></StackPanel></Button>
        </StackPanel>
        <Border Grid.Column="2" Height="42" CornerRadius="6" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBg}" BorderThickness="1" Margin="0,0,20,0" VerticalAlignment="Center"><Grid ColumnDefinitions="Auto,*"><Viewbox Width="17" Height="17" Margin="15,0,0,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M10.5,4 A6.5,6.5 0 1 1 10.48,4 M15.4,15.4 L20.5,20.5" Stroke="{DynamicResource TextFaintBg}" StrokeThickness="1.9" StrokeLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBox Grid.Column="1" x:Name="SearchBox" Classes="search" Watermark="Bu bölümde ara" TextChanged="SearchBox_TextChanged" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="11,0" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,10,0"/></Grid></Border>
      </Grid>
      <Grid x:Name="ContentBody" Grid.Row="1" ColumnDefinitions="486,*">
        <Border x:Name="ChannelPanel" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBg}" BorderThickness="0,0,1,0"><Grid RowDefinitions="56,*">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="18,0"><Button x:Name="SeriesBackButton" Classes="backButton" Click="SeriesBack_Click" IsVisible="False" Margin="0,0,10,0" ToolTip.Tip="Geri"><Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="M14,5 L7,12 L14,19" Stroke="{DynamicResource TextBg}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Classes="display" Text="Ulusal Kanallar" FontSize="24" LineHeight="27"/><TextBlock x:Name="BrowserTitle" Text="KANALLAR" FontSize="9" FontWeight="Bold" LetterSpacing="2" Margin="0,2,0,0" Foreground="{DynamicResource AccentBrush}"/></StackPanel><TextBlock Grid.Column="2" x:Name="ChannelCount" Text="0 kanal" VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBg}" FontSize="10"/><Button Grid.Column="3" x:Name="SortButton" Classes="backButton" Margin="10,0,0,0" ToolTip.Tip="Sırala ve filtrele"><Button.Flyout><Flyout Placement="BottomEdgeAlignedRight"><StackPanel Width="230" Spacing="14"><StackPanel Spacing="8"><TextBlock Classes="eyebrow" Text="SIRALAMA"/><StackPanel x:Name="SortModeList"><Button Classes="trackOption" Tag="default" Click="SetSortMode_Click" Content="Liste sırası" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="13,8" Margin="0,0,0,5"/><Button Classes="trackOption" Tag="az" Click="SetSortMode_Click" Content="A → Z" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="13,8" Margin="0,0,0,5"/><Button Classes="trackOption" Tag="za" Click="SetSortMode_Click" Content="Z → A" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="13,8" Margin="0,0,0,5"/><Button Classes="trackOption" Tag="new" Click="SetSortMode_Click" Content="Yeni eklenenler" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="13,8" Margin="0,0,0,5"/><Button Classes="trackOption" Tag="watched" Click="SetSortMode_Click" Content="En çok izlenen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="13,8" Margin="0,0,0,5"/></StackPanel></StackPanel><StackPanel Spacing="8"><TextBlock Classes="eyebrow" Text="FİLTRE"/><WrapPanel x:Name="QualityFilterChips"><Button Classes="chip" Tag="" Click="SetQualityFilter_Click" Content="Tümü"/><Button Classes="chip" Tag="hd" Click="SetQualityFilter_Click" Content="HD"/><Button Classes="chip" Tag="4k" Click="SetQualityFilter_Click" Content="4K"/><Button Classes="chip" Tag="fav" Click="SetQualityFilter_Click" Content="Favoriler"/></WrapPanel></StackPanel></StackPanel></Flyout></Button.Flyout><Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="M4,7 L20,7 M7,12 L17,12 M10,17 L14,17" Stroke="{DynamicResource TextBg}" StrokeThickness="2" StrokeLineCap="Round"/></Canvas></Viewbox></Button><Button Grid.Column="4" x:Name="ClearHistoryButton" Click="ClearRecentHistory_Click" IsVisible="False" Padding="9,5" Margin="8,0,0,0" FontSize="9"><StackPanel Orientation="Horizontal" Spacing="6"><Path Data="M6,7 H18 M9,7 V5 H15 V7 M8,9 V19 H16 V9 M10.5,11 V17 M13.5,11 V17" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeLineCap="Round" Width="13" Height="13" Stretch="Uniform"/><TextBlock x:Name="ClearHistoryText" Text="Geçmişi Temizle" VerticalAlignment="Center"/></StackPanel></Button></Grid>
          <ListBox Grid.Row="1" x:Name="ChannelList" Classes="cards" KeyDown="ChannelList_KeyDown"><ListBox.ItemTemplate><DataTemplate x:DataType="local:MediaBrowserItem"><Border Classes="channelCard" Height="116" CornerRadius="4" BorderThickness="1" Margin="14,4" Padding="12"><Grid ColumnDefinitions="132,*,Auto" ToolTip.Tip="{Binding Name}"><Grid.ContextMenu><ContextMenu Opening="ChannelContextMenu_Opening"><MenuItem x:Name="AddToCollectionMenu" Header="Koleksiyona ekle"/><MenuItem Header="Yeni koleksiyon oluştur" Click="CreateCollectionWithChannel_Click"/><MenuItem Header="Detayları göster" Click="ShowDetails_Click"/></ContextMenu></Grid.ContextMenu><local:ChannelLogo Width="132" Height="90" VerticalAlignment="Center" LogoUrl="{Binding LogoUrl}" Initials="{Binding Initials}"/><StackPanel Grid.Column="1" Margin="16,0,10,0" VerticalAlignment="Center" Spacing="7"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextFaintBg}" FontSize="11.5" TextTrimming="CharacterEllipsis"/><Border BorderBrush="{DynamicResource Border2Bg}" BorderThickness="1" CornerRadius="2" Padding="8,3" HorizontalAlignment="Left" Margin="0,2,0,0"><TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" LetterSpacing="1" Foreground="{DynamicResource TextMutedBg}"/></Border></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="10"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M12,2.5 L14.9,8.4 L21.4,9.3 L16.7,13.9 L17.8,20.4 L12,17.3 L6.2,20.4 L7.3,13.9 L2.6,9.3 L9.1,8.4 Z" Fill="Transparent" Stroke="{DynamicResource TextFaintBg}" StrokeThickness="1.7" StrokeJoin="Round"/></Canvas></Viewbox><Button Classes="historyAction" IsVisible="{Binding CanRemoveFromHistory}" CommandParameter="{Binding Channel}" Click="RemoveRecentItem_Click" HorizontalAlignment="Center"><Viewbox Width="10" Height="10"><Canvas Width="24" Height="24"><Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource TextBg}" StrokeThickness="2.4" StrokeLineCap="Round"/></Canvas></Viewbox></Button></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
        </Grid></Border>
        <Border x:Name="PlayerPanel" Grid.Column="1" Background="#08090B" ClipToBounds="True"><Grid x:Name="PlayerSurfaceLayout" ColumnDefinitions="*,0"><Grid x:Name="PlayerLayout" Grid.Column="0" RowDefinitions="*,Auto">
          <Grid Background="Black"><Border x:Name="PlayerPlaceholder" Background="#08090B"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15"><Border Width="72" Height="72" CornerRadius="24" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderBg}" BorderThickness="1"><Path Data="M7,4 L20,12 L7,20 Z" Fill="{DynamicResource AccentBrush}" Width="26" Height="26" Stretch="Uniform" Margin="4,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Classes="display" Text="İZLEMEYE HAZIR" FontSize="36" LineHeight="36" Foreground="#F2F4F7"/><TextBlock Text="Bir kanal veya içerik seç" Foreground="#6B7482"/></StackPanel></Border><local:NativeVlcHost x:Name="PlayerView" IsVisible="False"/><Button x:Name="MiniExitButton" IsVisible="False" Classes="playerAction" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Background="#9E0A0B0D" Click="ToggleMiniPlayer_Click" ToolTip.Tip="Mini oynatıcıdan çık"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M4,9 L4,4 L9,4 M15,4 L20,4 L20,9 M20,15 L20,20 L15,20 M9,20 L4,20 L4,15" Stroke="#F2F4F7" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button></Grid>
          <Grid x:Name="PlayerControls" Grid.Row="1" Background="{DynamicResource WindowBg}" RowDefinitions="Auto,*"><Border Grid.RowSpan="2" Height="1" Background="{DynamicResource DividerBg}" VerticalAlignment="Top"/><Grid x:Name="TimelinePanel" ColumnDefinitions="*,Auto" IsVisible="False" Margin="22,12,22,0"><Slider x:Name="Timeline" Minimum="0" Maximum="1" Value="0" IsEnabled="False"/><TextBlock Grid.Column="1" x:Name="TimeLabel" Text="CANLI" Foreground="{DynamicResource TextMutedBg}" FontSize="10" Margin="12,0,0,0"/></Grid>
            <Grid Grid.Row="1" RowDefinitions="Auto,Auto" Margin="22,10,22,12"><Grid ColumnDefinitions="Auto,*"><local:ChannelLogo x:Name="NowPlayingLogo" Width="76" Height="46" VerticalAlignment="Center" Margin="0,0,14,0" IsVisible="False"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><Grid ColumnDefinitions="Auto,Auto,*"><Border Background="#40EA2E4E" CornerRadius="100" Padding="8,3" VerticalAlignment="Center" Margin="0,0,7,0"><TextBlock x:Name="PlaybackKindBadge" Text="HAZIR" Foreground="#FF97A6" FontSize="8"/></Border><Border Grid.Column="1" x:Name="MediaInfoBadge" Background="{DynamicResource Surface2Bg}" BorderBrush="{DynamicResource Border2Bg}" BorderThickness="1" CornerRadius="100" Padding="8,2" VerticalAlignment="Center" Margin="0,0,9,0" IsVisible="False"><TextBlock x:Name="MediaInfoText" Text="" Foreground="{DynamicResource TextMutedBg}" FontSize="8" FontWeight="Bold"/></Border><TextBlock Grid.Column="2" x:Name="NowPlaying" Text="İzlemek için bir kanal seçin" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid><TextBlock x:Name="PlaybackStatus" Text="Hazır" Foreground="{DynamicResource TextMutedBg}" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid>
              <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderBg}" BorderThickness="1" Padding="5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0"><WrapPanel HorizontalAlignment="Center">
                <Button x:Name="PreviousChannelButton" Classes="playerAction" Click="PreviousChannel_Click" IsEnabled="False" ToolTip.Tip="Önceki kanal"><Viewbox Width="19" Height="19"><Canvas Width="24" Height="24"><Path Data="M6,5 L6,19 M19,5 L9,12 L19,19 Z" Stroke="{DynamicResource TextBg}" StrokeThickness="1.8" StrokeLineCap="Round" Fill="Transparent"/></Canvas></Viewbox></Button>
                <Button x:Name="LastChannelButton" Classes="playerAction" Click="LastChannel_Click" IsEnabled="False" ToolTip.Tip="Son kanal"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M4,4 L4,9 L9,9 M5.5,7 A8,8 0 1 1 4.8,15" Stroke="{DynamicResource TextBg}" StrokeThickness="1.8" StrokeLineCap="Round"/></Canvas></Viewbox></Button>
                <Button x:Name="NextChannelButton" Classes="playerAction" Click="NextChannel_Click" IsEnabled="False" ToolTip.Tip="Sonraki kanal"><Viewbox Width="19" Height="19"><Canvas Width="24" Height="24"><Path Data="M18,5 L18,19 M5,5 L15,12 L5,19 Z" Stroke="{DynamicResource TextBg}" StrokeThickness="1.8" StrokeLineCap="Round" Fill="Transparent"/></Canvas></Viewbox></Button>
                <Button x:Name="EpgButton" Classes="playerAction" Margin="7,0,0,0" Click="ToggleEpgPanel_Click" IsEnabled="False" ToolTip.Tip="Yayın akışı"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M4,5 L20,5 L20,20 L4,20 Z M8,2 L8,7 M16,2 L16,7 M4,10 L20,10 M8,14 L10,14 M14,14 L16,14 M8,17 L10,17 M14,17 L16,17" Stroke="{DynamicResource TextBg}" StrokeThickness="1.6" StrokeLineCap="Round"/></Canvas></Viewbox></Button>
                <Button x:Name="FavoriteButton" Classes="playerAction" Click="FavoriteButton_Click" IsEnabled="False" ToolTip.Tip="Favori"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path x:Name="FavoriteOutlineIcon" Data="M12,2.5 L14.9,8.4 L21.4,9.3 L16.7,13.9 L17.8,20.4 L12,17.3 L6.2,20.4 L7.3,13.9 L2.6,9.3 L9.1,8.4 Z" Fill="Transparent" Stroke="{DynamicResource TextBg}" StrokeThickness="1.8" StrokeJoin="Round"/><Path x:Name="FavoriteFilledIcon" Data="M12,2.5 L14.9,8.4 L21.4,9.3 L16.7,13.9 L17.8,20.4 L12,17.3 L6.2,20.4 L7.3,13.9 L2.6,9.3 L9.1,8.4 Z" Fill="{DynamicResource AccentBrush}" IsVisible="False"/></Canvas></Viewbox></Button>
                <Button x:Name="VolumeButton" Classes="playerAction" Click="VolumeButton_Click" ToolTip.Tip="Ses"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M3,9 L7,9 L12,5 L12,17 L7,13 L3,13 Z" Stroke="{DynamicResource TextBg}" StrokeThickness="1.7" StrokeLineCap="Round" Fill="Transparent"/><Path x:Name="VolumeWaveIcon" Data="M15,8 C17,10 17,12 15,14 M18,5 C22,9 22,13 18,17" Stroke="{DynamicResource TextBg}" StrokeThickness="1.7" StrokeLineCap="Round"/><Path x:Name="VolumeMutedIcon" Data="M15,9 L20,14 M20,9 L15,14" Stroke="#EA2E4E" StrokeThickness="1.8" StrokeLineCap="Round" IsVisible="False"/></Canvas></Viewbox></Button>
                <Border CornerRadius="6" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBg}" BorderThickness="1" Height="32" Padding="13,0" VerticalAlignment="Center" Margin="3,0,4,0"><StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center"><Slider x:Name="VolumeSlider" Classes="volume" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeSlider_ValueChanged"/><TextBlock x:Name="VolumeValueText" Text="%80" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBg}" Width="30" TextAlignment="Right" VerticalAlignment="Center"/></StackPanel></Border>
                <Border Width="1" Height="22" Background="{DynamicResource BorderBg}" Margin="7,0" VerticalAlignment="Center"/>
                <Button x:Name="RewindButton" Classes="playerAction" Click="Rewind_Click" IsVisible="False" IsEnabled="False" ToolTip.Tip="10 saniye geri"><Grid><Viewbox Width="23" Height="23"><Canvas Width="24" Height="24"><Path Data="M5,5 L5,10 L10,10 M6,8 A8,8 0 1 1 5,16" Stroke="{DynamicResource TextBg}" StrokeThickness="1.6" StrokeLineCap="Round"/></Canvas></Viewbox><TextBlock Text="10" FontSize="7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Button>
                <Button x:Name="ForwardButton" Classes="playerAction" Click="Forward_Click" IsVisible="False" IsEnabled="False" ToolTip.Tip="10 saniye ileri"><Grid><Viewbox Width="23" Height="23"><Canvas Width="24" Height="24"><Path Data="M19,5 L19,10 L14,10 M18,8 A8,8 0 1 0 19,16" Stroke="{DynamicResource TextBg}" StrokeThickness="1.6" StrokeLineCap="Round"/></Canvas></Viewbox><TextBlock Text="10" FontSize="7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Button>
                <Button x:Name="PlayPauseButton" Classes="playerAction primary" Click="PlayPause_Click" IsEnabled="False" ToolTip.Tip="Oynat / duraklat"><Path x:Name="PlayPauseIcon" Data="M3,2 L7,2 L7,18 L3,18 Z M13,2 L17,2 L17,18 L13,18 Z" Fill="#140F0D" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
                <Button x:Name="TrackButton" Classes="playerAction" IsEnabled="False" ToolTip.Tip="Ses ve altyazı"><Button.Flyout><Flyout Placement="Top"><ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="TrackFlyoutPanel" Width="272" Spacing="16"/></ScrollViewer></Flyout></Button.Flyout><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M3,5 L21,5 L21,19 L3,19 Z M6,14 L11,14 M14,14 L18,14 M6,10.5 L9,10.5 M12,10.5 L18,10.5" Stroke="{DynamicResource TextBg}" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent"/></Canvas></Viewbox></Button><Button x:Name="PlayerMoreButton" Classes="playerAction" ToolTip.Tip="Oynatma seçenekleri"><Button.Flyout><Flyout Placement="Top"><StackPanel Width="248" Spacing="16"><StackPanel Spacing="9"><TextBlock Classes="eyebrow" Text="OYNATMA HIZI"/><WrapPanel x:Name="PlaybackRateChips"><Button Classes="chip" Tag="0.5" Click="SetPlaybackRate_Click" Content="0,5×"/><Button Classes="chip" Tag="0.75" Click="SetPlaybackRate_Click" Content="0,75×"/><Button Classes="chip" Tag="1" Click="SetPlaybackRate_Click" Content="1×"/><Button Classes="chip" Tag="1.25" Click="SetPlaybackRate_Click" Content="1,25×"/><Button Classes="chip" Tag="1.5" Click="SetPlaybackRate_Click" Content="1,5×"/><Button Classes="chip" Tag="2" Click="SetPlaybackRate_Click" Content="2×"/></WrapPanel></StackPanel><StackPanel Spacing="9"><TextBlock Classes="eyebrow" Text="GÖRÜNTÜ ORANI"/><WrapPanel x:Name="AspectRatioChips"><Button Classes="chip" Tag="" Click="SetAspectRatio_Click" Content="Otomatik"/><Button Classes="chip" Tag="16:9" Click="SetAspectRatio_Click" Content="16:9"/><Button Classes="chip" Tag="4:3" Click="SetAspectRatio_Click" Content="4:3"/><Button Classes="chip" Tag="21:9" Click="SetAspectRatio_Click" Content="21:9"/></WrapPanel></StackPanel><Button Content="Ekran görüntüsü al" Click="TakeSnapshot_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/><Button Content="Mini oynatıcı" Click="ToggleMiniPlayer_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/></StackPanel></Flyout></Button.Flyout><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M5,12 A1.6,1.6 0 1 1 5.01,12 M12,12 A1.6,1.6 0 1 1 12.01,12 M19,12 A1.6,1.6 0 1 1 19.01,12" Stroke="{DynamicResource TextBg}" StrokeThickness="2.2" StrokeLineCap="Round"/></Canvas></Viewbox></Button><Button x:Name="FullscreenButton" Classes="playerAction" Click="Fullscreen_Click" ToolTip.Tip="Tam ekran"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M4,9 L4,4 L9,4 M15,4 L20,4 L20,9 M20,15 L20,20 L15,20 M9,20 L4,20 L4,15" Stroke="{DynamicResource TextBg}" StrokeThickness="1.8" StrokeLineCap="Round"/></Canvas></Viewbox></Button>
              </WrapPanel></Border>
            </Grid>
          </Grid>
        </Grid>
        <Border x:Name="DetailsPanel" Grid.Column="1" IsVisible="False" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBg}" BorderThickness="1,0,0,0" Padding="18"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="İÇERİK BİLGİSİ" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold" LetterSpacing="2" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="backButton" Click="CloseDetails_Click" ToolTip.Tip="Kapat"><Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource TextBg}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button></Grid><Border CornerRadius="4" ClipToBounds="True" Background="{DynamicResource Surface2Bg}" Height="380"><Image x:Name="DetailsPoster" Stretch="UniformToFill"/></Border><TextBlock x:Name="DetailsTitle" Classes="display" Text="" FontSize="28" LineHeight="28" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="9"><Border x:Name="DetailsRatingBadge" Background="{DynamicResource AccentTintStrongBrush}" CornerRadius="100" Padding="9,3" IsVisible="False"><TextBlock x:Name="DetailsRating" Text="" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentSoftBrush}"/></Border><Border x:Name="DetailsYearBadge" Background="{DynamicResource Surface2Bg}" CornerRadius="100" Padding="9,3" IsVisible="False"><TextBlock x:Name="DetailsYear" Text="" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBg}"/></Border></StackPanel><TextBlock x:Name="DetailsOverview" Text="" FontSize="12" Foreground="{DynamicResource TextMutedBg}" TextWrapping="Wrap" LineHeight="19"/><TextBlock x:Name="DetailsStatus" Text="" FontSize="11.5" Foreground="{DynamicResource TextFaintBg}" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Border><Border x:Name="EpgPanel" Grid.Column="1" IsVisible="False" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBg}" BorderThickness="1,0,0,0" Padding="18"><Grid RowDefinitions="Auto,Auto,Auto,Auto,*"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="7 GÜNLÜK YAYIN AKIŞI" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold" LetterSpacing="2"/><TextBlock x:Name="EpgChannelName" Classes="display" Text="Kanal" FontSize="30" LineHeight="30"/></StackPanel><Button Grid.Column="1" Classes="backButton" Click="CloseEpgPanel_Click" ToolTip.Tip="Kapat"><Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource TextBg}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button></Grid><Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBg}" Margin="0,15,0,10"/><Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto"><Button x:Name="EpgPreviousDayButton" Classes="backButton" Click="EpgPreviousDay_Click" ToolTip.Tip="Önceki gün"><Viewbox Width="13" Height="13"><Canvas Width="24" Height="24"><Path Data="M14,5 L7,12 L14,19" Stroke="{DynamicResource TextBg}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button><TextBlock Grid.Column="1" x:Name="EpgDateText" Text="BUGÜN" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Grid.Column="2" x:Name="EpgNextDayButton" Classes="backButton" Click="EpgNextDay_Click" ToolTip.Tip="Sonraki gün"><Viewbox Width="13" Height="13"><Canvas Width="24" Height="24"><Path Data="M10,5 L17,12 L10,19" Stroke="{DynamicResource TextBg}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button></Grid><StackPanel Grid.Row="3" Margin="0,8" Spacing="8"><TextBox x:Name="EpgSearchBox" Watermark="Program ara..." TextChanged="EpgSearchBox_TextChanged"/><StackPanel Orientation="Horizontal" Spacing="7"><Button x:Name="EpgScopeChannelButton" Classes="chip active" Tag="channel" Click="SetEpgSearchScope_Click" Content="Bu kanal"/><Button x:Name="EpgScopeAllButton" Classes="chip" Tag="all" Click="SetEpgSearchScope_Click" Content="Tüm kanallar"/></StackPanel></StackPanel><Grid Grid.Row="4"><TextBlock x:Name="EpgEmptyText" Text="Bu kanal için yayın akışı bulunamadı." Foreground="{DynamicResource TextFaintBg}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/><ListBox x:Name="EpgProgrammeList" IsVisible="False"><ListBox.ItemTemplate><DataTemplate x:DataType="local:EpgProgrammeItem"><Border Background="{Binding Background}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,4"><Grid ColumnDefinitions="56,*"><TextBlock Text="{Binding TimeText}" Foreground="{Binding TimeForeground}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding ChannelName}" IsVisible="{Binding HasChannel}" Foreground="{DynamicResource AccentSoftBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding Category}" Foreground="{DynamicResource AccentSoftBrush}" FontSize="9"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextFaint2Bg}" TextWrapping="Wrap" MaxHeight="38"/><TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AccentBrush}" FontSize="9" IsVisible="{Binding IsCurrent}"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Grid></Border>
        </Grid></Border>
      </Grid>
    </Grid>

    <Grid x:Name="SettingsPage" Grid.Column="1" Background="{DynamicResource WindowBg}" IsVisible="False" RowDefinitions="86,*">
      <Grid Margin="30,0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14" VerticalAlignment="Center"><Button Classes="navIcon" Click="HideSettings_Click" ToolTip.Tip="Geri"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M15,5 L8,12 L15,19" Stroke="{DynamicResource TextBg}" StrokeThickness="1.9" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Classes="display" Text="AYARLAR" FontSize="30" LineHeight="30"/><TextBlock x:Name="SettingsSubtitleText" Text="Oynatma Listeleri" FontSize="11" Foreground="{DynamicResource TextMutedBg}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="3" Content="Kapat" Click="HideSettings_Click"/></Grid>
      <Grid Grid.Row="1" ColumnDefinitions="252,*">
        <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBg}" BorderThickness="0,1,1,0"><StackPanel Margin="14,20" Spacing="4">
          <TextBlock Classes="eyebrow" Text="UYGULAMA" Margin="13,0,0,10"/>
        <Button x:Name="SettingsTabPlaylists" Classes="settingsTab active" Tag="playlists" Click="SettingsTab_Click"><Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center"><Viewbox Width="18" Height="18" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path x:Name="SettingsTabPlaylistsIcon" Data="M4,6 L15,6 M4,12 L15,12 M4,18 L11,18 M19,5 L19,15 M19,15 A2.4,2.4 0 1,1 16.6,15 A2.4,2.4 0 1,1 19,15" Stroke="{DynamicResource TextMutedBg}" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox><TextBlock Grid.Column="1" Text="Oynatma Listeleri" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left" /></Grid></Button>
        <Button x:Name="SettingsTabGeneral" Classes="settingsTab " Tag="general" Click="SettingsTab_Click"><Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center"><Viewbox Width="18" Height="18" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path x:Name="SettingsTabGeneralIcon" Data="M3,12 A9,9 0 1,1 21,12 A9,9 0 1,1 3,12 M3.4,9 L20.6,9 M3.4,15 L20.6,15 M12,3 C15,6.5 15,17.5 12,21 M12,3 C9,6.5 9,17.5 12,21" Stroke="{DynamicResource TextMutedBg}" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox><TextBlock Grid.Column="1" Text="Genel" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left" /></Grid></Button>
        <Button x:Name="SettingsTabUpdate" Classes="settingsTab " Tag="update" Click="SettingsTab_Click"><Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center"><Viewbox Width="18" Height="18" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path x:Name="SettingsTabUpdateIcon" Data="M12,4 L12,14.5 M7.8,10.3 L12,14.5 L16.2,10.3 M4.5,19 L19.5,19" Stroke="{DynamicResource TextMutedBg}" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox><TextBlock Grid.Column="1" Text="Güncelleme" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left" /></Grid></Button>
        <Button x:Name="SettingsTabStats" Classes="settingsTab " Tag="stats" Click="SettingsTab_Click"><Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center"><Viewbox Width="18" Height="18" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path x:Name="SettingsTabStatsIcon" Data="M4,20 L4,10 L8,10 L8,20 M10,20 L10,4 L14,4 L14,20 M16,20 L16,13 L20,13 L20,20 M3,20 L21,20" Stroke="{DynamicResource TextMutedBg}" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox><TextBlock Grid.Column="1" Text="İstatistikler" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left" /></Grid></Button>
        <Button x:Name="SettingsTabPrivacy" Classes="settingsTab " Tag="privacy" Click="SettingsTab_Click"><Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center"><Viewbox Width="18" Height="18" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path x:Name="SettingsTabPrivacyIcon" Data="M12,3 L20,6.4 L20,12 C20,16.4 16.6,19.8 12,21.4 C7.4,19.8 4,16.4 4,12 L4,6.4 Z M9,12.2 L11.3,14.5 L15.4,10" Stroke="{DynamicResource TextMutedBg}" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox><TextBlock Grid.Column="1" Text="Gizlilik" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left" /></Grid></Button>
        <Button x:Name="SettingsTabAbout" Classes="settingsTab " Tag="about" Click="SettingsTab_Click"><Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center"><Viewbox Width="18" Height="18" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path x:Name="SettingsTabAboutIcon" Data="M3,12 A9,9 0 1,1 21,12 A9,9 0 1,1 3,12 M12,11 L12,16.4 M12,7.4 L12,8.2" Stroke="{DynamicResource TextMutedBg}" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox><TextBlock Grid.Column="1" Text="Hakkında" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left" /></Grid></Button>
        </StackPanel></Border>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid Margin="34,26,34,36" MaxWidth="1000" HorizontalAlignment="Stretch">
          <StackPanel x:Name="SettingsSectionPlaylists" Spacing="16"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Classes="sectionTitle" Text="Oynatma Listeleri"/><TextBlock Classes="cardHint" Text="M3U, dosya veya Xtream hesabı ekleyin."/></StackPanel><Button Grid.Column="1" Content="Dosyadan ekle" Click="AddPlaylistFile_Click" VerticalAlignment="Center"/></Grid><Border Classes="card"><StackPanel Spacing="14"><TextBlock Classes="eyebrow" Text="M3U URL EKLE"/><Grid ColumnDefinitions="200,*,Auto" ColumnSpacing="10"><TextBox x:Name="PlaylistNameBox" Watermark="Liste adı"/><TextBox Grid.Column="1" x:Name="PlaylistUrlBox" Watermark="https://ornek.com/playlist.m3u"/><Button Grid.Column="2" Click="AddPlaylistUrl_Click"><StackPanel Orientation="Horizontal" Spacing="8"><Viewbox Width="13" Height="13"><Canvas Width="24" Height="24"><Path Data="M12,5 L12,19 M5,12 L19,12" Stroke="{DynamicResource TextBg}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox><TextBlock Text="Ekle"/></StackPanel></Button></Grid></StackPanel></Border><Border Classes="card"><StackPanel Spacing="14"><TextBlock Classes="eyebrow" Text="XTREAM HESABI EKLE"/><Grid ColumnDefinitions="170,*,170,170,Auto" ColumnSpacing="10"><TextBox x:Name="XtreamNameBox" Watermark="Hesap adı"/><TextBox Grid.Column="1" x:Name="XtreamServerBox" Watermark="http://sunucu:port"/><TextBox Grid.Column="2" x:Name="XtreamUsernameBox" Watermark="Kullanıcı adı"/><TextBox Grid.Column="3" x:Name="XtreamPasswordBox" Watermark="Şifre" PasswordChar="●"/><Button Grid.Column="4" Click="AddXtreamPlaylist_Click"><StackPanel Orientation="Horizontal" Spacing="8"><Viewbox Width="13" Height="13"><Canvas Width="24" Height="24"><Path Data="M12,5 L12,19 M5,12 L19,12" Stroke="{DynamicResource TextBg}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox><TextBlock Text="Xtream Ekle"/></StackPanel></Button></Grid></StackPanel></Border><Border Classes="card" Padding="22,20,22,14"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Classes="eyebrow" Text="KAYITLI LİSTELER"/><TextBlock Grid.Column="1" x:Name="PlaylistCountText" Classes="eyebrow" Foreground="{DynamicResource TextMutedBg}"/></Grid><ListBox x:Name="PlaylistSettingsList" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate x:DataType="local:PlaylistEntry"><Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderBg}" BorderThickness="1" CornerRadius="4" Padding="16,13" Margin="0,0,0,8"><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8"><StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DisplayPath}" FontSize="11" Foreground="{DynamicResource TextFaintBg}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Content="Yenile" Click="RefreshSavedPlaylist_Click" CommandParameter="{Binding}" VerticalAlignment="Center"/><Button Grid.Column="2" Content="{Binding ActiveText}" Click="ActivatePlaylist_Click" CommandParameter="{Binding}" VerticalAlignment="Center"/><Button Grid.Column="3" Content="Kaldır" Click="RemovePlaylist_Click" CommandParameter="{Binding}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border></StackPanel>
          <StackPanel x:Name="SettingsSectionGeneral" Spacing="16" IsVisible="False"><StackPanel Spacing="6"><TextBlock Classes="sectionTitle" Text="Genel"/><TextBlock Classes="cardHint" Text="Uygulama dilini seçin. Değişiklik anında uygulanır."/></StackPanel><Border Classes="card"><StackPanel Spacing="16"><TextBlock Classes="cardTitle" Text="Arayüz dili"/><Grid ColumnDefinitions="*,*" ColumnSpacing="14"><Button x:Name="LanguageTurkishButton" Classes="optionCard active" Tag="tr" Click="SetLanguage_Click"><Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center"><Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource Surface2Bg}"><TextBlock Text="TR" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center"><TextBlock Text="Türkçe" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Left" TextAlignment="Left"/><TextBlock Text="Varsayılan" FontSize="11" Foreground="{DynamicResource TextFaintBg}" Margin="0,3,0,0" HorizontalAlignment="Left" TextAlignment="Left"/></StackPanel><Viewbox Grid.Column="2" x:Name="LanguageTurkishCheck" Width="19" Height="19" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M4,12.6 L9.4,18 L20,7" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Grid></Button><Button Grid.Column="1" x:Name="LanguageEnglishButton" Classes="optionCard" Tag="en" Click="SetLanguage_Click"><Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center"><Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource Surface2Bg}"><TextBlock Text="EN" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextMutedBg}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center"><TextBlock Text="English" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Left" TextAlignment="Left"/><TextBlock Text="United Kingdom" FontSize="11" Foreground="{DynamicResource TextFaintBg}" Margin="0,3,0,0" HorizontalAlignment="Left" TextAlignment="Left"/></StackPanel><Viewbox Grid.Column="2" x:Name="LanguageEnglishCheck" Width="19" Height="19" VerticalAlignment="Center" IsVisible="False"><Canvas Width="24" Height="24"><Path Data="M4,12.6 L9.4,18 L20,7" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Grid></Button></Grid><TextBlock Classes="cardHint" Text="Kanal, film ve dizi adları oynatma listenizden geldiği için çevrilmez."/></StackPanel></Border><Border Classes="card"><StackPanel Spacing="16"><TextBlock Classes="cardTitle" Text="Görünüm"/><Grid ColumnDefinitions="*,*" ColumnSpacing="14"><Button x:Name="ThemeDarkButton" Classes="optionCard active" Tag="dark" Click="SetTheme_Click"><Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center"><Border Width="42" Height="42" CornerRadius="12" Background="#1C2026" BorderBrush="#343B45" BorderThickness="1"/><StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center"><TextBlock Text="Koyu" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Left" TextAlignment="Left"/><TextBlock Text="Varsayılan" FontSize="11" Foreground="{DynamicResource TextFaintBg}" Margin="0,3,0,0" HorizontalAlignment="Left" TextAlignment="Left"/></StackPanel><Viewbox Grid.Column="2" x:Name="ThemeDarkCheck" Width="19" Height="19" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M4,12.6 L9.4,18 L20,7" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Grid></Button><Button Grid.Column="1" x:Name="ThemeLightButton" Classes="optionCard" Tag="light" Click="SetTheme_Click"><Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center"><Border Width="42" Height="42" CornerRadius="12" Background="#F0F2F6" BorderBrush="#C6CDD8" BorderThickness="1"/><StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center"><TextBlock Text="Açık" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Left" TextAlignment="Left"/><TextBlock Text="Gündüz" FontSize="11" Foreground="{DynamicResource TextFaintBg}" Margin="0,3,0,0" HorizontalAlignment="Left" TextAlignment="Left"/></StackPanel><Viewbox Grid.Column="2" x:Name="ThemeLightCheck" Width="19" Height="19" VerticalAlignment="Center" IsVisible="False"><Canvas Width="24" Height="24"><Path Data="M4,12.6 L9.4,18 L20,7" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Grid></Button></Grid></StackPanel></Border><Border Classes="card"><StackPanel Spacing="14"><TextBlock Classes="cardTitle" Text="Görünen ad"/><TextBlock Classes="cardHint" Text="Ana ekrandaki selamlamada kullanılır. Boş bırakırsan Windows hesap adın kullanılır."/><Grid ColumnDefinitions="240,Auto,*" ColumnSpacing="10"><TextBox x:Name="DisplayNameBox" Watermark="Adın"/><Button Grid.Column="1" Content="Kaydet" Click="SaveDisplayName_Click"/></Grid></StackPanel></Border><Border Classes="card"><StackPanel Spacing="14"><TextBlock Classes="cardTitle" Text="Vurgu rengi"/><TextBlock Classes="cardHint" Text="Düğmeler, rozetler ve seçili öğeler bu renkle çizilir."/><StackPanel x:Name="AccentSwatches" Orientation="Horizontal" Spacing="10"><Button Classes="swatch" Tag="#F2622E" Click="SetAccentColor_Click" ToolTip.Tip="Turuncu"><Border Width="30" Height="30" CornerRadius="15" Background="#F2622E"/></Button><Button Classes="swatch" Tag="#2E7CF2" Click="SetAccentColor_Click" ToolTip.Tip="Mavi"><Border Width="30" Height="30" CornerRadius="15" Background="#2E7CF2"/></Button><Button Classes="swatch" Tag="#8B5CF6" Click="SetAccentColor_Click" ToolTip.Tip="Mor"><Border Width="30" Height="30" CornerRadius="15" Background="#8B5CF6"/></Button><Button Classes="swatch" Tag="#1FB981" Click="SetAccentColor_Click" ToolTip.Tip="Yeşil"><Border Width="30" Height="30" CornerRadius="15" Background="#1FB981"/></Button><Button Classes="swatch" Tag="#E8394B" Click="SetAccentColor_Click" ToolTip.Tip="Kırmızı"><Border Width="30" Height="30" CornerRadius="15" Background="#E8394B"/></Button></StackPanel></StackPanel></Border><Border Classes="card"><StackPanel Spacing="14"><TextBlock Classes="cardTitle" Text="İçerik bilgisi (TMDB)"/><TextBlock Classes="cardHint" Text="Film ve dizilerde afiş, puan ve özet göstermek için ücretsiz bir TMDB API anahtarı gerekir. Anahtar yalnızca bu cihazda saklanır."/><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"><TextBox x:Name="TmdbKeyBox" Watermark="TMDB API anahtarı" PasswordChar="●"/><Button Grid.Column="1" Content="Kaydet" Click="SaveTmdbKey_Click"/><Button Grid.Column="2" Classes="linkButton" Content="Anahtar al" Click="OpenTmdbSite_Click" VerticalAlignment="Center" Margin="6,0,0,0"/></Grid><TextBlock x:Name="TmdbStatusText" Classes="cardHint" Foreground="{DynamicResource AccentSoftBrush}" IsVisible="False"/></StackPanel></Border><Border Classes="card"><StackPanel Spacing="14"><TextBlock Classes="cardTitle" Text="Otomatik davranışlar"/><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5" VerticalAlignment="Center"><TextBlock Text="Son izlenen kanalı aç" FontSize="13"/><TextBlock Classes="cardHint" Text="Uygulama açılınca liste yüklendikten sonra en son izlediğin yayın başlar."/></StackPanel><ToggleSwitch Grid.Column="1" x:Name="ResumeLastChannelSwitch" OnContent="" OffContent="" VerticalAlignment="Center" IsCheckedChanged="ResumeLastChannel_Changed"/></Grid><Border Height="1" Background="{DynamicResource BorderBg}"/><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5" VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="Sonraki bölüme geç" FontSize="13"/><TextBlock Classes="cardHint" Text="Bir bölüm bitince aynı dizinin sıradaki bölümü kendiliğinden başlar."/></StackPanel><ToggleSwitch Grid.Column="1" x:Name="AutoNextEpisodeSwitch" OnContent="" OffContent="" VerticalAlignment="Center" IsCheckedChanged="AutoNextEpisode_Changed"/></Grid><Border Height="1" Background="{DynamicResource BorderBg}"/><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5" VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="Listeyi arka planda yenile" FontSize="13"/><TextBlock Classes="cardHint" Text="Uzak listeler altı saatte bir sessizce güncellenir, açılışı bekletmez."/></StackPanel><ToggleSwitch Grid.Column="1" x:Name="BackgroundRefreshSwitch" OnContent="" OffContent="" VerticalAlignment="Center" IsCheckedChanged="BackgroundRefresh_Changed"/></Grid></StackPanel></Border><Border Classes="card"><StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Classes="cardTitle" Text="Gizli gruplar"/><TextBlock Classes="cardHint" Text="Bir gruba sağ tıklayıp gizleyebilirsin; gizlenen gruplar listede görünmez."/></StackPanel><Button Grid.Column="1" x:Name="ShowAllGroupsButton" Content="Tümünü göster" Click="ShowAllGroups_Click" VerticalAlignment="Center"/></Grid><TextBlock x:Name="NoHiddenGroupsText" Classes="cardHint" Text="Gizlenmiş grup yok."/><ItemsControl x:Name="HiddenGroupsList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderBg}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Content="Göster" Click="UnhideGroup_Click" CommandParameter="{Binding}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Classes="card"><StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Classes="cardTitle" Text="Koleksiyonlar"/><TextBlock Classes="cardHint" Text="Bir içeriğe sağ tıklayıp koleksiyona ekleyebilirsin; koleksiyonlar grup listesinde görünür."/></StackPanel><Button Grid.Column="1" Content="Yeni koleksiyon" Click="CreateCollection_Click" VerticalAlignment="Center"/></Grid><TextBlock x:Name="NoCollectionsText" Classes="cardHint" Text="Henüz koleksiyon yok."/><ItemsControl x:Name="CollectionsList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:CollectionItem"><Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderBg}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,8"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"><TextBox Text="{Binding Name}" Tag="{Binding Name}" LostFocus="RenameCollection_LostFocus" FontSize="12.5" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource TextFaintBg}" VerticalAlignment="Center"/><Button Grid.Column="2" Content="Sil" Click="DeleteCollection_Click" CommandParameter="{Binding Name}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Classes="card"><StackPanel Spacing="12"><TextBlock Classes="cardTitle" Text="Klavye kısayolları"/><StackPanel Spacing="9"><Grid ColumnDefinitions="150,*"><Border Background="{DynamicResource Surface2Bg}" BorderBrush="{DynamicResource Border2Bg}" BorderThickness="1" CornerRadius="7" Padding="9,3" HorizontalAlignment="Left"><TextBlock Text="Boşluk" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock Grid.Column="1" Classes="cardHint" Text="Oynat / duraklat" VerticalAlignment="Center" Margin="14,0,0,0"/></Grid><Grid ColumnDefinitions="150,*"><Border Background="{DynamicResource Surface2Bg}" BorderBrush="{DynamicResource Border2Bg}" BorderThickness="1" CornerRadius="7" Padding="9,3" HorizontalAlignment="Left"><TextBlock Text="← / →" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock Grid.Column="1" Classes="cardHint" Text="10 saniye geri / ileri" VerticalAlignment="Center" Margin="14,0,0,0"/></Grid><Grid ColumnDefinitions="150,*"><Border Background="{DynamicResource Surface2Bg}" BorderBrush="{DynamicResource Border2Bg}" BorderThickness="1" CornerRadius="7" Padding="9,3" HorizontalAlignment="Left"><TextBlock Text="↑ / ↓" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock Grid.Column="1" Classes="cardHint" Text="Sesi artır / azalt" VerticalAlignment="Center" Margin="14,0,0,0"/></Grid><Grid ColumnDefinitions="150,*"><Border Background="{DynamicResource Surface2Bg}" BorderBrush="{DynamicResource Border2Bg}" BorderThickness="1" CornerRadius="7" Padding="9,3" HorizontalAlignment="Left"><TextBlock Text="M" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock Grid.Column="1" Classes="cardHint" Text="Sessize al" VerticalAlignment="Center" Margin="14,0,0,0"/></Grid><Grid ColumnDefinitions="150,*"><Border Background="{DynamicResource Surface2Bg}" BorderBrush="{DynamicResource Border2Bg}" BorderThickness="1" CornerRadius="7" Padding="9,3" HorizontalAlignment="Left"><TextBlock Text="F" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock Grid.Column="1" Classes="cardHint" Text="Tam ekran" VerticalAlignment="Center" Margin="14,0,0,0"/></Grid><Grid ColumnDefinitions="150,*"><Border Background="{DynamicResource Surface2Bg}" BorderBrush="{DynamicResource Border2Bg}" BorderThickness="1" CornerRadius="7" Padding="9,3" HorizontalAlignment="Left"><TextBlock Text="Esc" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock Grid.Column="1" Classes="cardHint" Text="Tam ekrandan çık" VerticalAlignment="Center" Margin="14,0,0,0"/></Grid><Grid ColumnDefinitions="150,*"><Border Background="{DynamicResource Surface2Bg}" BorderBrush="{DynamicResource Border2Bg}" BorderThickness="1" CornerRadius="7" Padding="9,3" HorizontalAlignment="Left"><TextBlock Text="Page Up / Page Down" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock Grid.Column="1" Classes="cardHint" Text="Önceki / sonraki kanal" VerticalAlignment="Center" Margin="14,0,0,0"/></Grid><Grid ColumnDefinitions="150,*"><Border Background="{DynamicResource Surface2Bg}" BorderBrush="{DynamicResource Border2Bg}" BorderThickness="1" CornerRadius="7" Padding="9,3" HorizontalAlignment="Left"><TextBlock Text="Backspace" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock Grid.Column="1" Classes="cardHint" Text="Son kanala dön" VerticalAlignment="Center" Margin="14,0,0,0"/></Grid><Grid ColumnDefinitions="150,*"><Border Background="{DynamicResource Surface2Bg}" BorderBrush="{DynamicResource Border2Bg}" BorderThickness="1" CornerRadius="7" Padding="9,3" HorizontalAlignment="Left"><TextBlock Text="S" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock Grid.Column="1" Classes="cardHint" Text="Ekran görüntüsü al" VerticalAlignment="Center" Margin="14,0,0,0"/></Grid></StackPanel></StackPanel></Border></StackPanel>
          <StackPanel x:Name="SettingsSectionUpdate" Spacing="16" IsVisible="False"><StackPanel Spacing="6"><TextBlock Classes="sectionTitle" Text="Güncelleme"/><TextBlock Classes="cardHint" Text="Uygulama her açılışta güncellemeleri kendiliğinden denetler."/></StackPanel><Border Classes="card"><StackPanel Spacing="18"><Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center"><Border Width="52" Height="52" CornerRadius="15" Background="{DynamicResource AccentTintBrush}"><Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Data="M12,4 L12,14.5 M7.8,10.3 L12,14.5 L16.2,10.3 M4.5,19 L19.5,19" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox></Border><StackPanel Grid.Column="1" Margin="16,0,14,0" VerticalAlignment="Center"><TextBlock Classes="cardTitle" Text="Yüklü sürüm"/><TextBlock x:Name="SettingsVersionText" Text="1.0.0" FontSize="12" Foreground="{DynamicResource TextMutedBg}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="2" x:Name="CheckUpdatesButton" Content="Güncellemeleri denetle" Click="CheckUpdatesNow_Click" VerticalAlignment="Center"/></Grid><Border Height="1" Background="{DynamicResource BorderBg}"/><StackPanel Spacing="14"><TextBlock x:Name="SettingsUpdateStatus" Classes="cardHint" Text="Güncellemeleri denetle"/><StackPanel x:Name="SettingsUpdateActions" Orientation="Horizontal" Spacing="10" IsVisible="False"><Button x:Name="SettingsUpdateNowButton" Content="Şimdi güncelle" Click="UpdateNow_Click"/><Button Classes="linkButton" Content="Sürüm notlarını aç" Click="OpenUpdate_Click" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel></StackPanel></StackPanel></Border><Border Classes="card"><StackPanel Spacing="12"><TextBlock Classes="cardTitle" Text="Güvenli güncelleme"/><TextBlock Classes="cardHint" Text="Güncellemeler yalnızca projenin resmî GitHub sürüm sayfasından indirilir."/><TextBlock Classes="cardHint" Text="İndirilip kurulur, ardından uygulama 