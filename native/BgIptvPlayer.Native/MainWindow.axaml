    <Border x:Name="UpdateBanner" Grid.Column="1" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="38,20" Padding="18,14" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4" MaxWidth="520"><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="14"><StackPanel VerticalAlignment="Center" MaxWidth="250"><TextBlock x:Name="UpdateTitle" Text="Yeni sürüm hazır" FontWeight="SemiBold"/><TextBlock x:Name="UpdateStatusText" Text="İndirilip kurulur, ardından uygulama yeniden başlar." FontSize="11" Foreground="{DynamicResource TextMutedBg}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" x:Name="UpdateNowButton" Content="Güncelle" Click="UpdateNow_Click" VerticalAlignment="Center"/><Button Grid.Column="2" Classes="linkButton" Content="Notlar" Click="OpenUpdate_Click" VerticalAlignment="Center"/><Button Grid.Column="3" Classes="backButton" Click="DismissUpdate_Click" VerticalAlignment="Center" ToolTip.Tip="Kapat"><Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource TextBg}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button></Grid></Border>
      <Grid x:Name="LoadingOverlay" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource WindowBg}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" Width="340">
          <Image Source="avares://BG-IPTV-Player/Assets/app-icon.png" Height="86" HorizontalAlignment="Center"/>
          <StackPanel Spacing="8">
            <TextBlock Classes="display" Text="BG IPTV PLAYER" FontSize="34" LineHeight="34" HorizontalAlignment="Center"/>
            <TextBlock x:Name="LoadingStatusText" Text="Oynatma listesi hazırlanıyor..." FontSize="12.5" Foreground="{DynamicResource TextMutedBg}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <ProgressBar IsIndeterminate="True" Height="4" Width="240" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
  </Grid>
</Window>
